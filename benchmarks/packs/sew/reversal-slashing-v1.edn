                              :consensus/finality
                              :consensus/escalation
                              :consensus/liveness
                              :consensus/legitimacy
                              :concept/confidence
                              :allocation/pro-rata-fairness]
 :benchmark/review-guide    "benchmarks/packs/sew/REVERSAL_SLASHING_REVIEW.md"
 :benchmark/review-coverage
 {:claim/reversal-reviewer-due-process
