# Development-only PostgreSQL configuration for docker-compose.
# Copy to config/compose.postgres.env (NOT committed) and adjust as needed.
# Compose is loaded with:  docker compose --env-file config/compose.postgres.env
# Never commit real credentials. These defaults are loopback dev values only.

PRG_POSTGRES_IMAGE=postgres:16-alpine
PRG_POSTGRES_USER=postgres
PRG_POSTGRES_PASSWORD=postgres
PRG_POSTGRES_DB=postgres
PRG_POSTGRES_PORT=5433

# Ephemeral disposable instance used only by the automated integration-test
# harness. Lives on a disjoint host port so it never collides with the
# persistent dev instance.
PRG_POSTGRES_TEST_PORT=5434
PRG_POSTGRES_TEST_USER=postgres
PRG_POSTGRES_TEST_PASSWORD=postgres
PRG_POSTGRES_TEST_DB=postgres_test