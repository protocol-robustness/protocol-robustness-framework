{:scenario-id "dr-c-003-appeal-bond-refund-on-reversal"
 :schema-version "1.0"
 :allow-open-disputes? true
 :purpose "behavioural-correction"
 :title "Appeal bond refunded on reversal through recordResolution"
 :description "A dispute is escalated and the higher-level resolver flips the decision. The appeal bond must be refunded to the depositor. Verifies that distributeAppealBond(true) is called atomically from recordResolution when the new decision differs from the prior round."
 :provenance {:author "@bond-ledger" :created-at "2026-07-30" :license "CC-BY-4.0"}
 :claim {:id "appeal-bond-refund-on-reversal"
         :statement "When a higher-level resolver reverses a prior round's decision, the appeal bond is refunded to the escalator through the recordResolution production path."
         :falsifies-if ["Bond is not refunded after reversal"
                        "Bond refund requires a separate governance action beyond recordResolution"
                        "Distribution failure is silently swallowed without reverting resolution"]}
 :expectations {:terminal-state "released"
                :must-hold ["refund_claimable_created"]
                :metrics {:refund_amount {:eq 1000000}
                          :bond_distributed true
                          :resolution_reverted_on_failure false}}
 :threat {:family "bond-lifecycle" :attack "missing-refund" :severity "critical"
          :actors ["challenger"]
          :assumptions ["appeal-bond-bps = 500" "escalation-cost-enabled"]}
 :accounting {:unit "USDC" :decimals 6 :tracked-balances ["buyer" "seller" "challenger" "l0resolver"]}
 :initial-block-time 1000
 :protocol-params {:resolver-fee-bps 150 :appeal-window-duration 60 :max-dispute-duration 2592000 :appeal-bond-bps 500 :dispute-resolver "0xl0" :escalation-resolvers {:0 "0xl0" :1 "0xl1"}}
 :agents [{:id "buyer" :address "0xbuyer" :strategy "honest"}
          {:id "seller" :address "0xseller" :strategy "honest"}
          {:id "l0resolver" :address "0xl0" :role "resolver"}
          {:id "l1resolver" :address "0xl1" :role "resolver"}
          {:id "challenger" :address "0xchallenger" :strategy "honest"}
          {:id "keeper" :address "0xkeeper" :role "keeper"}]
 :events [{:seq 0 :time 1000 :agent "buyer" :action "create_escrow"
           :params {:token "USDC" :to "0xseller" :amount 5000}}
          {:seq 1 :time 1060 :agent "seller" :action "raise_dispute" :params {:workflow-id 0}}
          {:seq 2 :time 1100 :agent "l0resolver" :action "execute_resolution"
           :params {:workflow-id 0 :is-release false :resolution-hash "0xhash0"}}
          {:seq 3 :time 1120 :agent "challenger" :action "challenge_resolution" :params {:workflow-id 0}}
          {:seq 4 :time 1150 :agent "l1resolver" :action "execute_resolution"
           :params {:workflow-id 0 :is-release true :resolution-hash "0xhash1"}}
          {:seq 5 :time 1300 :agent "keeper" :action "execute_pending_settlement" :params {:workflow-id 0}}]}
