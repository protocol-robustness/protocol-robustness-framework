{:scenario-id "Y14_round-two-shared-liquidity"
 :id "Y14"
 :schema-version "1.1"
 :title "Round-Two Shared-Liquidity Re-Admission with Lineage Conservation"
 :purpose "functional-test"
 :threat-tags ["shortfall" "pro-rata" "partial-fill" "caps" "round-two" "lineage"]
 :scenario-author "agent-c"
 :protocol "yield-v1"
 :initial-block-time 1000000
 :protocol-params {:yield-profile "aave-v3" :token "USDC" :focus-owner-id "0xAlice"}
 :agents [{:id "0xAlice" :address "0xAlice" :role "provider"}
          {:id "0xBob" :address "0xBob" :role "provider"}
          {:id "0xCarol" :address "0xCarol" :role "provider"}
          {:id "0xDan" :address "0xDan" :role "provider"}
          {:id "governance" :address "governance" :role "governance"}]
 :events [{:seq 0 :time 1000000 :agent "0xAlice" :action "yield_deposit" :params {:amount 100 :token "USDC" :owner-id "0xAlice"}}
          {:seq 1 :time 1000000 :agent "0xBob" :action "yield_deposit" :params {:amount 100 :token "USDC" :owner-id "0xBob"}}
          {:seq 2 :time 1000000 :agent "0xCarol" :action "yield_deposit" :params {:amount 100 :token "USDC" :owner-id "0xCarol"}}
          {:seq 3 :time 1000000 :agent "0xDan" :action "yield_deposit" :params {:amount 100 :token "USDC" :owner-id "0xDan"}}
          {:seq 4 :time 1100000 :agent "governance" :action "set-yield-risk"
           :params {:token "USDC" :shortfall {:available-ratio 0.35 :reason "liquidity-crunch"}}}
          {:seq 5 :time 1200000 :agent "governance" :action "yield_withdraw_shared"
           :params {:token "USDC" :module-id "aave-v3" :owner-ids ["0xAlice" "0xBob" "0xCarol" "0xDan"]
                    :allocation-mode "pro-rata"
                    :effective-caps {"0xAlice" 30 "0xBob" 40 "0xCarol" 50}}}
          {:seq 6 :time 1300000 :agent "governance" :action "yield_recover_liquidity" :params {:token "USDC"}}
          {:seq 7 :time 1400000 :agent "governance" :action "yield_withdraw_shared"
           :params {:token "USDC" :module-id "aave-v3" :owner-ids ["0xAlice" "0xBob" "0xCarol" "0xDan"]
                    :allocation-mode "pro-rata"
                    :effective-caps {"0xAlice" 30 "0xBob" 40 "0xCarol" 50}}}
          ;; Negative control: 0xDan was fully satisfied in round 2 and is no longer
          ;; an eligible deferred position, so including him rejects the whole op.
          {:seq 8 :time 1500000 :agent "governance" :action "yield_withdraw_shared"
           :params {:token "USDC" :module-id "aave-v3" :owner-ids ["0xAlice" "0xBob" "0xCarol" "0xDan"]
                    :allocation-mode "pro-rata"
                    :effective-caps {"0xAlice" 30 "0xBob" 40 "0xCarol" 50}}}
          ;; Round 3: a still-outstanding eligible deferred lineage (0xAlice, 40)
          ;; is re-admitted without a cap and fully satisfied from residual liquidity.
          {:seq 9 :time 1600000 :agent "governance" :action "yield_withdraw_shared"
           :params {:token "USDC" :module-id "aave-v3" :owner-ids ["0xAlice"]
                    :allocation-mode "pro-rata"}}]
 :expected-outcomes [{:seq 5 :action "yield_withdraw_shared" :expect "ok"}
                     {:seq 7 :action "yield_withdraw_shared" :expect "ok"}
                     {:seq 8 :action "yield_withdraw_shared" :expect "rejected"}
                     {:seq 9 :action "yield_withdraw_shared" :expect "ok"}]
 :expectations {:step-terminal
                [{:seq 7 :path ["yield-positions" "0xAlice" "cumulative-fulfilled"] :op ":=" :value 60}
                 {:seq 7 :path ["yield-positions" "0xAlice" "shortfall" "deferred-amount"] :op ":=" :value 40}
                 {:seq 7 :path ["yield-positions" "0xBob" "cumulative-fulfilled"] :op ":=" :value 77}
                 {:seq 7 :path ["yield-positions" "0xBob" "shortfall" "deferred-amount"] :op ":=" :value 23}
                 {:seq 7 :path ["yield-positions" "0xCarol" "cumulative-fulfilled"] :op ":=" :value 87}
                 {:seq 7 :path ["yield-positions" "0xCarol" "shortfall" "deferred-amount"] :op ":=" :value 13}
                 {:seq 7 :path ["yield-positions" "0xDan" "cumulative-fulfilled"] :op ":=" :value 100}
                 {:seq 7 :path ["yield-positions" "0xDan" "status"] :equals "withdrawn"}
                 {:seq 9 :path ["yield-positions" "0xAlice" "cumulative-fulfilled"] :op ":=" :value 100}
                 {:seq 9 :path ["yield-positions" "0xAlice" "status"] :equals "withdrawn"}]
                :metrics
                [{:name "yield/positions-count" :op ":=" :value 4}
                 {:name "yield/total-principal" :op ":=" :value 400}
                 {:name "yield/total-deferred" :op ":=" :value 36}
                 {:name "yield/focus-status" :op ":=" :value "withdrawn"}]}}
