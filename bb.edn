{:tasks
{sim:run {:doc "Run a simulation with EDN params"
            :task (apply clojure {:dir "." :extra-deps {}} "-M:run:with-sew" *command-line-args*)}

  public-claims:generate
  {:doc "Validate the public headline-claim registry and generate public copy."
   :task (shell "clojure" "-M" "-m" "scripts.generate-public-headline-claims")}

  claim-bindings:validate
  {:doc "CI acceptance gate for public claim bindings; writes target/claim-binding-report.json."
   :task (shell "clojure" "-M:with-sew" "-m" "scripts.validate-claim-bindings")}

  run:scenario
  {:doc "Run one scenario into a self-contained evidence bundle.
Usage: bb run:scenario <scenario-id> [--run-root <dir>] [--report-format <summary|failures|standard|verbose|audit> | -v | -f | -s | -a]
       --output-dir and --scenario-output-dir are deprecated aliases for --run-root.
       --save-output is rejected; use a dedicated export command instead."
   :task (apply clojure "-M:with-sew" "-m" "resolver-sim.commands.scenario" *command-line-args*)}

   cli {:doc "Run a registered command through the unified CLI (same as prf.jar).
Usage: bb cli <command-path> [args]
Example: bb cli scenario list --search yield"
        :task (apply clojure "-M:with-sew" "-m" "resolver-sim.cli.main" *command-line-args*)}

 run:scenario:search
 {:doc "Find scenarios matching text and run each in an isolated run root."
  :task (apply clojure "-M:cli/sew" "scenario" "run-search" *command-line-args*)}

 artifacts:refresh
  {:doc "Refresh results/test-artifacts and golden reports by running all canonical fixture suites in :save mode.
         Outputs new .report.edn files to data/fixtures/golden/ and emits test artifacts.
         Also touches notebooks/report.clj to trigger Clerk re-evaluation if the server is running."
   :task (shell "scripts/with-test-artifact-lock.sh" "./scripts/test.sh" "suites")}

  regenerate-goldens
  {:doc "Regenerate golden report files (data/fixtures/golden/*.report.edn) by running all fixture suites in :save mode.
         The golden reports are the pinned per-scenario replay outcomes that the report notebook loads.
         Run this after fixing a failing scenario to update its golden artifact.
         Touches notebooks/report.clj afterward so a running Clerk server re-evaluates the report notebook.
         See also: scripts/scenarios/regenerate_goldens.clj, deps.edn :regenerate-goldens alias."
    :task (shell "scripts/with-test-artifact-lock.sh" "clojure" "-M:regenerate-goldens:with-sew")}

  evidence:sign
  {:doc "Sign the focused or latest run manifest after ensuring artifact registry exists. Usage: bb evidence:sign <path-to-private-key>"
   :task (let [key (first *command-line-args*)]
           (when-not (seq key)
             (throw (ex-info "Missing key path. Usage: bb evidence:sign <private-key-path>" {})))
           (clojure {:dir "." :extra-deps {}} "-M" "-m" "resolver-sim.scripts.evidence" "sign" key))}

  evidence:bundle
  {:doc "Export an evidence bundle for the focused/latest run. Usage: bb evidence:bundle [out-dir]"
   :task (let [outdir (or (first *command-line-args*)
                          (try (-> (clojure.java.shell/sh "python3" "-c" "from scripts.evidence_config import EvidenceConfig; print(EvidenceConfig().evidence_bundle_dir)") :out str/trim)
                               (catch Exception _ "results/evidence-bundle")))]
           (clojure {:dir "." :extra-deps {}} "-M" "-m" "resolver-sim.scripts.evidence" "bundle" outdir))}
  fixtures:sync {:doc "Sync trace.json + scenarios/edn/*.edn from Clojure invariant scenario source"
                 :task (clojure {:dir "."} "-M:sync-trace-fixtures")}

  fixtures:generate-traces
  {:doc "Generate .trace.json files for golden reports that lack matching trace metadata.
         Scans data/fixtures/golden/*.report.edn, finds orphans (no matching trace),
         replays the matching scenario from scenarios/edn/*.edn, and writes the trace file.
         After completion, touches notebooks/report.clj to notify Clerk."
   :task (clojure {:dir "."} "-M:generate-missing-traces")}

  docs:scenarios {:doc "Regenerate S01–S23 table in docs/scenarios.md from doc-summaries.clj"
                  :task (clojure {:dir "."} "-M:generate-scenario-docs")}

