{:tasks
{sim:run {:doc "Run a simulation with EDN params"
            :task (apply clojure {:dir "." :extra-deps {}} "-M:run:with-sew" *command-line-args*)}

  public-claims:generate
  {:doc "Validate the public headline-claim registry and generate public copy."
   :task (shell "clojure" "-M" "-m" "scripts.generate-public-headline-claims")}

  claim-bindings:validate
  {:doc "CI acceptance gate for public claim bindings; writes target/claim-binding-report.json."
   :task (shell "clojure" "-M:with-sew" "-m" "scripts.validate-claim-bindings")}

  run:scenario
  {:doc "Run one scenario into a self-contained evidence bundle.
Usage: bb run:scenario <scenario-id> [--run-root <dir>] [--report-format <summary|failures|standard|verbose|audit> | -v | -f | -s | -a]
       --output-dir and --scenario-output-dir are deprecated aliases for --run-root.
       --save-output is rejected; use a dedicated export command instead."
   :task (apply clojure "-M:with-sew" "-m" "resolver-sim.commands.scenario" *command-line-args*)}

   cli {:doc "Run a registered command through the unified CLI (same as prf.jar).
Usage: bb cli <command-path> [args]
Example: bb cli scenario list --search yield"
        :task (apply clojure "-M:with-sew" "-m" "resolver-sim.cli.main" *command-line-args*)}

 run:scenario:search
 {:doc "Find scenarios matching text and run each in an isolated run root."
  :task (apply clojure "-M:cli/sew" "scenario" "run-search" *command-line-args*)}

 artifacts:refresh
  {:doc "Refresh results/test-artifacts and golden reports by running all canonical fixture suites in :save mode.
         Outputs new .report.edn files to data/fixtures/golden/ and emits test artifacts.
         Also touches notebooks/report.clj to trigger Clerk re-evaluation if the server is running."
   :task (shell "scripts/with-test-artifact-lock.sh" "./scripts/test.sh" "suites")}

  regenerate-goldens
  {:doc "Regenerate golden report files (data/fixtures/golden/*.report.edn) by running all fixture suites in :save mode.
         The golden reports are the pinned per-scenario replay outcomes that the report notebook loads.
         Run this after fixing a failing scenario to update its golden artifact.
         Touches notebooks/report.clj afterward so a running Clerk server re-evaluates the report notebook.
         See also: scripts/scenarios/regenerate_goldens.clj, deps.edn :regenerate-goldens alias."
    :task (shell "scripts/with-test-artifact-lock.sh" "clojure" "-M:regenerate-goldens:with-sew")}

  evidence:sign
  {:doc "Sign the focused or latest run manifest after ensuring artifact registry exists. Usage: bb evidence:sign <path-to-private-key>"
   :task (let [key (first *command-line-args*)]
           (when-not (seq key)
             (throw (ex-info "Missing key path. Usage: bb evidence:sign <private-key-path>" {})))
           (clojure {:dir "." :extra-deps {}} "-M" "-m" "resolver-sim.scripts.evidence" "sign" key))}

  evidence:bundle
  {:doc "Export an evidence bundle for the focused/latest run. Usage: bb evidence:bundle [out-dir]"
   :task (let [outdir (or (first *command-line-args*)
                          (try (-> (clojure.java.shell/sh "python3" "-c" "from scripts.evidence_config import EvidenceConfig; print(EvidenceConfig().evidence_bundle_dir)") :out str/trim)
                               (catch Exception _ "results/evidence-bundle")))]
           (clojure {:dir "." :extra-deps {}} "-M" "-m" "resolver-sim.scripts.evidence" "bundle" outdir))}
  fixtures:sync {:doc "Sync trace.json + scenarios/edn/*.edn from Clojure invariant scenario source"
                 :task (clojure {:dir "."} "-M:sync-trace-fixtures")}

  fixtures:generate-traces
  {:doc "Generate .trace.json files for golden reports that lack matching trace metadata.
         Scans data/fixtures/golden/*.report.edn, finds orphans (no matching trace),
         replays the matching scenario from scenarios/edn/*.edn, and writes the trace file.
         After completion, touches notebooks/report.clj to notify Clerk."
   :task (clojure {:dir "."} "-M:generate-missing-traces")}

  docs:scenarios {:doc "Regenerate S01–S23 table in docs/scenarios.md from doc-summaries.clj"
                  :task (clojure {:dir "."} "-M:generate-scenario-docs")}

   test {:doc "Run canonical validation gate (all targets via scripts/test.sh)"
         :task (shell "scripts/with-test-artifact-lock.sh" "./scripts/test.sh" "all")}

   check:load
   {:doc "Corruption guard: require every reachable namespace under src+protocols_src
and fail on any that won't load. Catches silent source truncation where a file
compiles standalone but is missing symbols referenced by consumers. Run before
deploying notebooks so a corrupt repo never ships to the host.
Usage: bb check:load [--roots src protocols_src]"
    :task (apply shell "clojure" "-M:with-sew:check" "-m" "scripts.check-load" *command-line-args*)}

   check
   {:doc "Run both corruption guards (check:load + check:defs) in sequence."
    :task (shell "bash" "-c" "bb check:load && bb check:defs")}

   check:defs
   {:doc "Corruption guard: verify every source namespace still has all defs recorded
in checks/ns-defs.edn. Catches silent truncation where a file still loads but lost
a definition. Regenerate the golden after legitimately adding/removing defs.
Usage: bb check:defs [--generate] [--roots src protocols_src]"
    :task (apply shell "clojure" "-M:check" "-m" "scripts.check-defs" *command-line-args*)}

   test:concurrent
   {:doc "Run canonical validation gate with a dedicated artifact dir. Can run alongside bb test, bb backstop, etc."
    :task (shell "bash" "-c"
            "PRF_ARTIFACT_DIR=results/test-artifacts-$(date -u +%Y%m%dT%H%M%SZ) ./scripts/test.sh all")}

    test:framework:parallel
     {:doc "Run framework unit tests in parallel with noop evidence capture"
     :task (shell "env" "PARALLEL_TEST_LEAK_CHECK=1" "clojure" "-M:test" "-m" "scripts.parallel-test-runner" "--noop-capture"
                  "resolver-sim.core-tests"
                  "resolver-sim.protocol-alignment-test"
                  "resolver-sim.time.context-test"
                  "resolver-sim.time.model-test"
                  "resolver-sim.sim.defection-test"
                  "resolver-sim.sim.strategy-adaptation-test"
                  "resolver-sim.sim.waterfall-test"
                  "resolver-sim.workflow-group-test"
                  "resolver-sim.hash.algorithm-test"
                  "resolver-sim.deferral-test"
                  "resolver-sim.claim-outcome-test"
                  "resolver-sim.grounded-amount-test")}

   test:unit:parallel
   {:doc "Run all unit tests (framework + Sew) in parallel with noop capture.
          Delegates to scripts/test.sh unit — run_unit there is the single
          source of truth for the unit namespace list."
    :task (shell "scripts/with-test-artifact-lock.sh" "./scripts/test.sh" "unit")}

   test:evidence
   {:doc "Run evidence-chain unit tests (node, chain, registry, attestation, integrity, qol) with noop capture"
    :task (shell "env" "PARALLEL_TEST_LEAK_CHECK=1" "clojure" "-M:test:with-sew" "-m" "scripts.parallel-test-runner" "--noop-capture"
                 "resolver-sim.evidence.node-test"
                 "resolver-sim.evidence.chain-test"
                 "resolver-sim.evidence.registry-test"
                 "resolver-sim.evidence.qol-test"
                 "resolver-sim.evidence.integrity-test"
                 "resolver-sim.evidence.attestation-dag-test"
                 "resolver-sim.evidence.attestation-test"
                 "resolver-sim.evidence.attestation-node-test"
                  "resolver-sim.evidence.attestation-registry-test"
                  "resolver-sim.evidence.attestation-adversarial-test"
                  "resolver-sim.evidence.attestation-policy-test"
                  "resolver-sim.evidence.timestamping-test"
                  "resolver-sim.evidence.revocation-test"
                   "resolver-sim.evidence.commitment-root-test")}

   test:evidence-known-gaps
   {:doc "Run attestation known-gap characterisation tests (non-gating). These tests document
          places where the current implementation accepts inputs a hardened system should reject.
          They assert the current insecure behaviour and are not part of any CI gate."
    :task (shell "env" "PARALLEL_TEST_LEAK_CHECK=1" "clojure" "-M:test:with-sew" "-m" "scripts.parallel-test-runner" "--noop-capture"
                 "resolver-sim.evidence.attestation-known-gaps-test")}
    
   test:unit
   {:doc "Run all unit tests (framework + Sew) with noop capture (single JVM,
          namespaces parallel by default: isolated-parallel mode — each
          namespace has a fresh evidence/artifact scope and runs on a bounded
          pool.  Set SEW_TEST_MODE=shared-sequential or SEW_TEST_SEQUENTIAL=1
          for legacy sequential behaviour; PARALLEL_TEST_JOBS caps workers.
          Known pre-existing failures: idempotence-checklist-test,
          properties-test."
    :task (shell "clojure" "-M:test:with-sew" "-m" "scripts.run-sew-tests" "unit")}

    test:framework
     {:doc "Run framework unit tests with noop capture (single JVM)"
      :task (shell "env" "PARALLEL_TEST_LEAK_CHECK=1" "clojure" "-M:test" "-m" "scripts.parallel-test-runner" "--noop-capture"
                  "resolver-sim.core-tests"
                  "resolver-sim.protocol-alignment-test"
                  "resolver-sim.time.context-test"
                  "resolver-sim.time.model-test"
                  "resolver-sim.sim.defection-test"
                  "resolver-sim.sim.strategy-adaptation-test"
                  "resolver-sim.sim.waterfall-test"
                  "resolver-sim.workflow-group-test"
                  "resolver-sim.hash.algorithm-test"
                  "resolver-sim.deferral-test"
                  "resolver-sim.claim-outcome-test"
                  "resolver-sim.grounded-amount-test")}

   test:benchmark:e2e
  {:doc "Run benchmark report end-to-end tests using fixture evidence bundles.
         Tests the full pipeline: evidence bundle → resolve-report → report map validation.
         Does not require bb benchmark:run — uses pre-generated .evidence.edn fixtures."
   :task (clojure {:dir "."} "-M:test" "-e"
                  "(require (quote resolver-sim.benchmark.report-test))
                   (clojure.test/run-tests (quote resolver-sim.benchmark.report-test))")}

   test:yield {:doc "Run yield protocol unit tests only"
              :task (shell "scripts/with-test-artifact-lock.sh" "./scripts/test.sh" "yield")}

  test:yield-provider-scenarios {:doc "Run standalone yield-v1 JSON scenarios"
                                 :task (shell "scripts/with-test-artifact-lock.sh" "./scripts/test.sh" "yield-provider-scenarios")}

  test:sew-yield-scenarios {:doc "Run Sew escrow + yield integration JSON scenarios"
                            :task (shell "scripts/with-test-artifact-lock.sh" "./scripts/test.sh" "sew-yield-scenarios")}

  test:yield-scenarios {:doc "Compatibility alias for both yield path suites"
                         :task (shell "scripts/with-test-artifact-lock.sh" "./scripts/test.sh" "yield-scenarios")}

  test:speds {:doc "Run SPEDS visual narrative tests"
              :task (shell "scripts/with-test-artifact-lock.sh" "clojure" "-M:test:with-sew" "-e"
                           "(require (quote resolver-sim.notebooks.speds.findings-comparator-test)
                                      (quote resolver-sim.notebooks.speds.issues-shadow-report-test)
                                      (quote resolver-sim.notebooks.speds.core-test)
                                      (quote resolver-sim.notebooks.speds.risk-test)
                                      (quote resolver-sim.notebooks.speds.var-test))
                            (clojure.test/run-tests
                              (quote resolver-sim.notebooks.speds.findings-comparator-test)
                              (quote resolver-sim.notebooks.speds.issues-shadow-report-test)
                              (quote resolver-sim.notebooks.speds.core-test)
                              (quote resolver-sim.notebooks.speds.risk-test)
                              (quote resolver-sim.notebooks.speds.var-test))")}

  scenario-registry:validate
   {:doc "Validate the invariant scenario registry and file-backed scenario suite registry"
    :task (clojure {:dir "." :extra-deps {}}
                   "-M" "-m" "resolver-sim.validation.scenario-registry")}

  risk:projection
  {:doc "Generate risk-projection.v1 artifact + risk card over the latest event-evidence bundle"
   :task (clojure {:dir "." :extra-deps {}}
                  "-M:test" "-m" "scripts.scenarios.generate-risk-projection")}

  shadow:check
  {:doc "Check simulation namespaces for Solidity shadow registry coverage. Flags unregistered namespaces."
   :task (clojure {:dir "." :extra-deps {}}
                  "-M:with-sew"
                  "-e" "(require (quote resolver-sim.definitions.solidity-shadow-registry))
                        (let [unregistered (resolver-sim.definitions.solidity-shadow-registry/check-shadow-coverage)]
                          (if (seq unregistered)
                            (do (println \"Unregistered namespaces:\")
                                (doseq [m unregistered]
                                  (println \"  \" (:namespace m)))
                                (println (str (count unregistered) \" unregistered namespace(s)\"))
                                (System/exit 1))
                            (println \"All simulation namespaces have shadow entries.\")))")}

  shadow:report
  {:doc "Print a human-readable summary of the Solidity shadow registry."
   :task (clojure {:dir "." :extra-deps {}}
                  "-M:with-sew"
                  "-e" "(require (quote resolver-sim.definitions.solidity-shadow-registry))
                        (println (resolver-sim.definitions.solidity-shadow-registry/format-shadow-report))")}

  run:scenario:suites
  {:doc "Compatibility alias for suite:list."
   :task (run 'suite:list)}

  test:generators {:doc "Run canonical generator/property regression target"
                   :task (shell "./scripts/test.sh generators")}

  test:contracts {:doc "Run canonical cross-layer contract target (proto/service/wire compatibility)"
                  :task (shell "./scripts/test.sh contracts")}

test:invariants {:doc "Run canonical deterministic invariant target (S01–S41)"
                   :task (shell "./scripts/test.sh invariants")}

   test:dispute-resolution {:doc "Run dispute resolution coverage scenarios (S-DR-*)"
                            :task (shell "scripts/with-test-artifact-lock.sh" "./scripts/test.sh" "dispute-resolution")}

   test:suites {:doc "Run canonical fixture suites target (serial)"
                :task (shell "scripts/with-test-artifact-lock.sh" "./scripts/test.sh" "suites")}

   test:reference-validation
   {:doc "Run reference validation suite v1 (full run + verify)"
    :task (shell "scripts/with-test-artifact-lock.sh" "./scripts/test.sh" "reference-validation")}

   test:suites:parallel
   {:doc "Run canonical fixture suites in parallel (default 4 workers, set PARALLEL_WORKERS to tune)"
    :task (shell "env" "PARALLEL_WORKERS=4" "scripts/with-test-artifact-lock.sh" "./scripts/test.sh" "suites")}

   test:fast
   {:doc "Run core regression targets; excludes explicit slow targets such as monte-carlo and long-horizon"
    :task (shell "scripts/with-test-artifact-lock.sh" "./scripts/test.sh" "fast")}

   test:slow
  {:doc "Run slow tests only (monte-carlo, long-horizon, etc.)"
   :task (shell "scripts/with-test-artifact-lock.sh" "./scripts/test.sh" "slow")}

   test:dr3-coverage
   {:doc "Run DR3 critical suite + release-mapping drift checks."
    :task (shell "scripts/with-test-artifact-lock.sh" "./scripts/test.sh" "dr3-coverage")}

   test:long-horizon
   {:doc "Run extended horizon scenarios (100/200/500/1000 epochs)."
    :task (shell "scripts/with-test-artifact-lock.sh" "./scripts/test.sh" "long-horizon")}

  test:ci
  {:doc "CI-optimized test suite (fast tests + monte-carlo, < 2 minutes total)"
   :task (shell "scripts/with-test-artifact-lock.sh" "./scripts/test.sh" "ci")}

  test:ci:parallel
  {:doc "CI-optimized suite with target-level parallelism (independent targets run
         concurrently, each in its own isolated artifact subdir). ~2-4x faster wall-clock."
   :task (shell "scripts/with-test-artifact-lock.sh" "bash" "-c"
           "PARALLEL_TARGETS=1 ./scripts/test.sh ci")}

  test:parallel:smoke
  {:doc "Smoke test: verify parallel suite dispatch matches serial results (4 suites)"
   :task (shell "bash" "scripts/test_parallel_suites.sh")}

  test:parallel:evidence-chain
  {:doc "Test evidence chain integrity under concurrent scenario execution"
   :task (shell "clojure" "-M:test:with-sew" "-i" "scripts/test_parallel_evidence_chain.clj")}

   test:parallel:isolation
   {:doc "Verify per-namespace artifact isolation in parallel runs"
    :task (shell "clojure" "-M:test:with-sew" "-i" "scripts/test_artifact_isolation.clj")}

   test:staging
   {:doc "Verify PARALLEL_TEST_RUN_ROOT staging + collector consumption"
    :task (shell "clojure" "-M:test:with-sew" "-i" "scripts/test_run_root_staging.clj")}

   audit:parallel
   {:doc "Static audit of all namespace-parallel test lanes (run-sew-tests
         unit + scenario, and every namespace run through
         scripts.parallel-test-runner).  Fails if a lane's HARD-hazard
         namespace is missing from its exclusion set, or if a scenario-group
         member runs in the parallel-test-runner pool."
    :task (shell "clojure" "-M:test:with-sew" "-m" "scripts.audit-parallel-safety" "all")}

   audit:artifacts
   {:doc "Audit the consolidated test-artifact registry (schema, path
         resolution, config-declared ids, duplicate ids, dangling dependencies)
         and, when --producer-roots is supplied, producer ownership markers.
         Usage: bb audit:artifacts [--registry <path>] [--producer-roots <dirs...>]"
    :task (apply shell "python3" "scripts/evidence/audit_artifacts.py" *command-line-args*)}

   test:triage {:doc "Run failure triage grouped by purpose/threat-tag"
                :task (shell "scripts/with-test-artifact-lock.sh" "./scripts/test.sh" "triage")}

   test:notebooks {:doc "Load every notebook namespace to verify it compiles"
                    :task (shell "scripts/with-test-artifact-lock.sh" "clojure" "-M:with-sew" "-m" "scripts.test-notebooks")}

   demo:not-admitted
   {:doc "Run the 'not admitted' demonstration (tamper with the amount):
         a plain-language walkthrough of question -> original -> change ->
         same check again -> why, backed by the real verifier.
         --json prints the machine-readable demo model;
         --check exits non-zero if any committed expectation fails."
    :task (apply clojure "-M" "-m" "resolver-sim.demos.not-admitted.cli" *command-line-args*)}

   demo:reorder-chain
   {:doc "Run the 'reorder the evidence' demonstration: does the same evidence
         in a different order mean the same thing?
         --json prints the machine-readable demo model;
         --check exits non-zero if any committed expectation fails."
    :task (apply clojure "-M" "-m" "resolver-sim.demos.reorder-chain.cli" *command-line-args*)}

   demo:liquidity-shortfall
   {:doc "Run the 'liquidity shortfall' demonstration: what happens when
         legitimate requests compete for scarce liquidity?
         --json prints the machine-readable demo model;
         --check exits non-zero if any committed expectation fails."
    :task (apply clojure "-M" "-m" "resolver-sim.demos.liquidity-shortfall.cli" *command-line-args*)}

   demo:test
   {:doc "Run the demo assertion suites (A: not admitted; B: reorder chain; C: liquidity shortfall; plus the public projections)."
    :task (shell "clojure" "-M:test" "-e" "(require 'resolver-sim.demos.not-admitted.demo-test 'resolver-sim.demos.reorder-chain.demo-test 'resolver-sim.demos.liquidity-shortfall.demo-test 'resolver-sim.demos.public.blocked-decision-test 'resolver-sim.demos.public.liquidity-shortfall-test 'resolver-sim.demos.public.reordered-evidence-test 'resolver-sim.demos.public.provenance-test) (clojure.test/run-tests 'resolver-sim.demos.not-admitted.demo-test 'resolver-sim.demos.reorder-chain.demo-test 'resolver-sim.demos.liquidity-shortfall.demo-test 'resolver-sim.demos.public.blocked-decision-test 'resolver-sim.demos.public.liquidity-shortfall-test 'resolver-sim.demos.public.reordered-evidence-test 'resolver-sim.demos.public.provenance-test)")}

   demo:public-build
   {:doc "Generate the public-demo.v1 JSON artifacts for the product site
         (site/generated/demos/<id>.json). Projected from the executable PRF
         demo results; fails closed if required evidence is absent.
         Usage: bb demo:public-build [--id <demo-id>] [--out <path>]"
    :task (apply clojure "-M:test" "-m" "scripts.demos.export-public-demo" *command-line-args*)}

   demo:public-check
   {:doc "Regenerate the public-demo.v1 JSON artifacts and compare against the
         committed files. Exits non-zero on drift, so the public demos cannot
         silently diverge from what PRF actually computes.
         Usage: bb demo:public-check [--id <demo-id>] [--out <path>]"
    :task (apply clojure "-M:test" "-m" "scripts.demos.export-public-demo" "--check" *command-line-args*)}

   demo:public-lab
   {:doc "Build the static Clerk notebooks behind the public demos into
         site/out/lab/notebooks/<name>/ (composed with the site at publish
         time). These are the executable surfaces the demo pages deep-link to.
         Usage: bb demo:public-lab [--out <path>] [--nb <notebook.clj>]"
    :task (do
            (let [args (vec *command-line-args*)
                  out-idx (.indexOf args "--out")
                  nb-idx (.indexOf args "--nb")
                  out (if (and (not= -1 out-idx) (seq (drop (inc out-idx) args)))
                        (nth args (inc out-idx))
                        "site/out/lab")
                  nbs (if (and (not= -1 nb-idx) (seq (drop (inc nb-idx) args)))
                        [(nth args (inc nb-idx))]
                        ["notebooks/not_admitted.clj"
                         "notebooks/pro_rata_allocation_result.clj"])
                  expr (str "(require '[nextjournal.clerk :as clerk]) "
                            "(clerk/build! {:paths " (pr-str nbs)
                            " :out-path " (pr-str out)
                            " :package :directory}) (println :lab-built)")]
              (shell "clojure" "-M:with-sew" "-e" expr)))}

