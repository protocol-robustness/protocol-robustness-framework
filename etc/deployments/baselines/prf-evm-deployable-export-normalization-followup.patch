+/** Return project-relative POSIX paths for Foundry's absolute source paths. */
+export function normalizeForgeSourcePath(sourcePath: string, projectRoot: string): string {
+  if (sourcePath === 'unknown' || !path.isAbsolute(sourcePath)) return sourcePath.replaceAll('\\', '/');
+  const relative = path.relative(path.resolve(projectRoot), path.resolve(sourcePath));
+  if (relative === '..' || relative.startsWith(`..${path.sep}`) || path.isAbsolute(relative)) return sourcePath;
+  return relative.split(path.sep).join('/');
+}
