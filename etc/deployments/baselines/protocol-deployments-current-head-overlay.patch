+  'repeated-withdrawal',
+] as const;
+
+/** Required transaction chronology so each negative action exercises its intended boundary. */
+export const CAPITAL_FLOW_EXECUTION_ORDER = [
+  'unauthorized-configuration-route',
+  'wrong-instance',
+  'operation-preparation',
+  'stale-c0-admission',
+  'stale-c0-assurance',
