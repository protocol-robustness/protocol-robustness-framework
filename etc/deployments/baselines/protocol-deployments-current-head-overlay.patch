+import { createHash } from 'crypto';
+import * as fs from 'fs';
+import { canonicalJson } from '../canonical-json';
+import { ConfigError } from '../errors';
+
+export interface PlanVerificationReportInput {
+  planId: string;
+  executionStatus: 'complete' | 'partial';
+  planExecutionRoot: string;
+  manifestRoot: string;
+  resolvedSpecSha256: string;
+  replayedPrfAssertions: number;
+  liveVerificationRoot: string;
+  capitalFlowEvidenceRoot: string | null;
+  replayedCapitalFlowTransactions: number;
+  replayedCapitalFlowStateAssertions: number;
+}
+
+export const PLAN_VERIFICATION_TRUST_ASSUMPTIONS = [
+  'The caller supplies the trusted-context root independently and verifies that its approval keys and source pins are controlled by the intended local authority.',
+  'The selected RPC endpoint reports authentic chain identity, historical block hashes, transaction receipts, and contract state for the local Anvil instance.',
+  'The pinned PRF checkout, deployment source bundle, compiler artifacts, and fixture bundle are the reviewed inputs selected by the qualification authority.',
+  'The human approval decision and custody of the configured approval keys are trusted; cryptographic verification proves key use and scope, not the legitimacy of that decision.',
+  'Capital-flow getter targets and arguments are checked against the pinned topology and transaction bindings; producer-supplied expected historical values still require qualification review against the approved operation.',
+  'Proof-system soundness and external toolchain supply-chain integrity remain assumptions outside this deployment-evidence verifier.',
+] as const;
+
+export interface PlanVerificationReportV3 extends PlanVerificationReportInput {
+  schema: 'protocol-deployment-independent-verification/v3';
+  status: 'verified';
+  scope: 'local-anvil-only';
+  qualification: 'verification-evidence-only-not-approval';
+  trustAssumptions: readonly string[];
+  reportRoot: string;
+}
+
+function validInput(input: PlanVerificationReportInput): boolean {
+  return typeof input.planId === 'string' && input.planId.length > 0 &&
+      (input.executionStatus === 'complete' || input.executionStatus === 'partial') &&
+      /^0x[0-9a-f]{64}$/.test(input.planExecutionRoot) &&
+      /^0x[0-9a-f]{64}$/.test(input.manifestRoot) &&
+      /^[0-9a-f]{64}$/.test(input.resolvedSpecSha256) &&
+      Number.isSafeInteger(input.replayedPrfAssertions) && input.replayedPrfAssertions >= 0 &&
+      /^0x[0-9a-f]{64}$/.test(input.liveVerificationRoot) &&
+      (input.capitalFlowEvidenceRoot === null || /^0x[0-9a-f]{64}$/.test(input.capitalFlowEvidenceRoot)) &&
+      Number.isSafeInteger(input.replayedCapitalFlowTransactions) && input.replayedCapitalFlowTransactions >= 0 &&
+      Number.isSafeInteger(input.replayedCapitalFlowStateAssertions) && input.replayedCapitalFlowStateAssertions >= 0 &&
+      ((input.capitalFlowEvidenceRoot === null) === (input.replayedCapitalFlowTransactions === 0)) &&
+      ((input.capitalFlowEvidenceRoot === null) === (input.replayedCapitalFlowStateAssertions === 0));
+}
+
+export function buildPlanVerificationReport(input: PlanVerificationReportInput): PlanVerificationReportV3 {
+  if (!validInput(input)) {
+    throw new ConfigError('CONFIG_SCHEMA', 'Independent verification report input is incomplete or malformed');
+  }
+  const body = {
+    schema: 'protocol-deployment-independent-verification/v3' as const,
+    status: 'verified' as const,
+    scope: 'local-anvil-only' as const,
+    qualification: 'verification-evidence-only-not-approval' as const,
+    trustAssumptions: [...PLAN_VERIFICATION_TRUST_ASSUMPTIONS],
+    ...input,
+  };
+  return {
+    ...body,
+    reportRoot: createHash('sha256').update(canonicalJson(body), 'utf8').digest('hex'),
+  };
+}
+
+export function verifyPlanVerificationReport(value: unknown): PlanVerificationReportV3 {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    throw new ConfigError('PLAN_VERIFICATION_REPORT_INVALID', 'Independent verification report must be a JSON object');
+  }
+  const report = value as Partial<PlanVerificationReportV3>;
+  const { reportRoot, ...body } = report;
+  const input: PlanVerificationReportInput = {
+    planId: report.planId ?? '',
+    executionStatus: report.executionStatus ?? 'partial',
+    planExecutionRoot: report.planExecutionRoot ?? '',
+    manifestRoot: report.manifestRoot ?? '',
+    resolvedSpecSha256: report.resolvedSpecSha256 ?? '',
+    replayedPrfAssertions: report.replayedPrfAssertions ?? -1,
+    liveVerificationRoot: report.liveVerificationRoot ?? '',
+    capitalFlowEvidenceRoot: report.capitalFlowEvidenceRoot ?? null,
+    replayedCapitalFlowTransactions: report.replayedCapitalFlowTransactions ?? -1,
+    replayedCapitalFlowStateAssertions: report.replayedCapitalFlowStateAssertions ?? -1,
+  };
+  const expectedKeys = ['planId', 'executionStatus', 'planExecutionRoot', 'manifestRoot', 'resolvedSpecSha256',
+    'replayedPrfAssertions', 'liveVerificationRoot', 'capitalFlowEvidenceRoot', 'replayedCapitalFlowTransactions', 'replayedCapitalFlowStateAssertions', 'schema', 'status', 'scope',
+    'qualification', 'trustAssumptions', 'reportRoot'].sort();
+  if (canonicalJson(Object.keys(report).sort()) !== canonicalJson(expectedKeys) ||
+      report.schema !== 'protocol-deployment-independent-verification/v3' || report.status !== 'verified' ||
+      report.scope !== 'local-anvil-only' || report.qualification !== 'verification-evidence-only-not-approval' ||
+      !validInput(input) || !Array.isArray(report.trustAssumptions) ||
+      canonicalJson(report.trustAssumptions) !== canonicalJson(PLAN_VERIFICATION_TRUST_ASSUMPTIONS) ||
+      typeof reportRoot !== 'string' || !/^[0-9a-f]{64}$/.test(reportRoot) ||
+      createHash('sha256').update(canonicalJson(body), 'utf8').digest('hex') !== reportRoot) {
+    throw new ConfigError('PLAN_VERIFICATION_REPORT_INVALID', 'Independent verification report fields, trust assumptions, or digest are invalid');
+  }
+  return report as PlanVerificationReportV3;
+}
+
+export function persistPlanVerificationReport(report: PlanVerificationReportV3, file: string): void {
+  const verified = verifyPlanVerificationReport(report);
+  const content = `${JSON.stringify(verified, null, 2)}\n`;
+  try { fs.writeFileSync(file, content, { flag: 'wx' }); }
+  catch (error) {
+    if (!fs.existsSync(file) || fs.readFileSync(file, 'utf8') !== content) {
+      throw new ConfigError('PLAN_VERIFICATION_REPORT_CONFLICT', `Refusing to overwrite incompatible verification report '${file}': ${error instanceof Error ? error.message : String(error)}`);
+    }
+  }
+}
diff --git a/src/deployment/prf-authority-transition.ts b/src/deployment/prf-authority-transition.ts
new file mode 100644
index 0000000..d85780b
--- /dev/null
+++ b/src/deployment/prf-authority-transition.ts
@@ -0,0 +1,144 @@
+import * as fs from 'fs';
+import * as path from 'path';
+import { createHash } from 'crypto';
+import { spawnSync } from 'child_process';
+import { ConfigError } from '../errors';
+
+export interface PrfAuthorityTransitionInput {
+  prfRoot: string;
+  requestPath: string;
+  trustedContextPath: string;
+}
+
+export interface PrfAuthorityTransitionScope {
+  'chain-instance-genesis-root': string;
+  'adapter-address': string;
+  'previous-root': string;
+  'successor-root': string;
+  'policy-root': string;
+  'decision-root': string;
+  'transition-root': string;
+  'execution-commitment': string;
+  'previous-revision': number;
+  'successor-revision': number;
+}
+
+export interface PrfAuthorityMutation {
+  kind: number;
+  decisionRoot: string;
+  targetMode: number;
+  targetRoot: string;
+  parentConfigurationRoot: string;
+  newConfigurationRoot: string;
+  parentVerifierRegistryRoot: string;
+  newVerifierRegistryRoot: string;
+  epoch: number;
+  proofMode: number;
+}
+
+export interface PrfAuthorityTransitionEvidence {
+  schema: 'prf-authority-transition-verification.v1';
+  verifierCommand: string[];
+  inputs: Array<{ role: string; path: string; sha256: string }>;
+  output: string;
+  outputSha256: string;
+  scope: PrfAuthorityTransitionScope;
+  decisionPreimagesRoot: string;
+  executionMutationRoot: string;
+  mutations: PrfAuthorityMutation[];
+  attestation: `0x${string}`;
+}
+
+export type PrfAuthorityTransitionCommand = (
+  command: string,
+  args: string[],
+  options: { cwd: string; encoding: 'utf8' },
+) => { status: number | null; error?: Error; stdout?: string; stderr?: string };
+
+function canonicalJson(value: unknown): string {
+  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(',')}]`;
+  if (value && typeof value === 'object') {
+    const entries = Object.entries(value as Record<string, unknown>).sort(([a], [b]) => a.localeCompare(b));
+    return `{${entries.map(([key, nested]) => `${JSON.stringify(key)}:${canonicalJson(nested)}`).join(',')}}`;
+  }
+  return JSON.stringify(value);
+}
+
+function fail(code: string, message: string): never { throw new ConfigError(code, message); }
+
+/** Require PRF's independent semantic, C1-preimage and EIP-191 verifier. */
+export function verifyPrfAuthorityTransition(
+  input: PrfAuthorityTransitionInput,
+  expectedScope: Partial<PrfAuthorityTransitionScope>,
+  run: PrfAuthorityTransitionCommand = (command, args, options) => spawnSync(command, args, options),
+): PrfAuthorityTransitionEvidence {
+  const prfRoot = path.resolve(input.prfRoot);
+  const files = [input.requestPath, input.trustedContextPath].map((file) => path.resolve(prfRoot, file));
+  for (const file of files) {
+    let stat: fs.Stats;
+    try { stat = fs.statSync(file); }
+    catch (error) {
+      throw new ConfigError('PRF_AUTHORITY_TRANSITION_INPUT_MISSING', `Authority-transition input is unavailable: ${path.relative(prfRoot, file)}`, {
+        path: file, details: { reason: error instanceof Error ? error.message : String(error) },
+      });
+    }
+    if (!stat.isFile()) throw new ConfigError('PRF_AUTHORITY_TRANSITION_INPUT_INVALID', `Authority-transition input is not a regular file: ${path.relative(prfRoot, file)}`, { path: file });
+  }
+  const relativeFiles = files.map((file) => path.relative(prfRoot, file));
+  const args = ['-M:test', '-m', 'scripts.deployment.authority-transition-review', 'verify-json', ...relativeFiles];
+  const result = run('clojure', args, { cwd: prfRoot, encoding: 'utf8' });
+  if (result.error || result.status !== 0) {
+    throw new ConfigError('PRF_AUTHORITY_TRANSITION_REJECTED', 'PRF rejected the authority-state transition or its EIP-191 attestation', {
+      details: { exitCode: result.status, error: result.error?.message, output: (result.stderr ?? result.stdout ?? '').slice(-4000) },
+    });
+  }
+  let parsed: Record<string, unknown>;
+  try { parsed = JSON.parse(result.stdout ?? '') as Record<string, unknown>; }
+  catch { return fail('PRF_AUTHORITY_TRANSITION_INVALID_RESULT', 'PRF authority-transition verifier returned malformed JSON'); }
+  if (parsed.valid !== true || parsed.qualification !== 'authenticated-authority-transition' ||
+      !parsed.scope || typeof parsed.scope !== 'object') {
+    throw new ConfigError('PRF_AUTHORITY_TRANSITION_INVALID_RESULT', 'PRF did not authenticate the authority-state transition');
+  }
+  const scope = parsed.scope as PrfAuthorityTransitionScope;
+  const selectedScope = Object.fromEntries(Object.keys(expectedScope).map((key) => [key, (scope as unknown as Record<string, unknown>)[key]]));
+  if (canonicalJson(selectedScope) !== canonicalJson(expectedScope)) {
+    throw new ConfigError('PRF_AUTHORITY_TRANSITION_SCOPE_MISMATCH', 'Authority transition differs from the exact live C1 deployment scope', {
+      details: { expectedScope, actualScope: scope },
+    });
+  }
+  const hex32 = (value: unknown): value is string => typeof value === 'string' && /^0x[0-9a-f]{64}$/.test(value);
+  if (!hex32(parsed['decision-preimages-root']) || !hex32(parsed['execution-mutation-root']) ||
+      typeof parsed.attestation !== 'string' || !/^0x[0-9a-f]{130}$/.test(parsed.attestation) ||
+      !Array.isArray(parsed.mutations) || parsed.mutations.length === 0) {
+    throw new ConfigError('PRF_AUTHORITY_TRANSITION_INVALID_RESULT', 'PRF verifier output omitted canonical mutation or attestation data');
+  }
+  const mutations = parsed.mutations.map((raw): PrfAuthorityMutation => {
+    if (!raw || typeof raw !== 'object') return fail('PRF_AUTHORITY_TRANSITION_INVALID_RESULT', 'PRF returned a malformed authority mutation');
+    const mutation = raw as Record<string, unknown>;
+    const numbers = ['kind', 'targetMode', 'epoch', 'proofMode'];
+    if (numbers.some((key) => !Number.isInteger(mutation[key])) ||
+        ![0, 1, 2].includes(mutation.kind as number) || !hex32(mutation.decisionRoot) ||
+        !hex32(mutation.targetRoot) || !hex32(mutation.parentConfigurationRoot) ||
+        !hex32(mutation.newConfigurationRoot) || !hex32(mutation.parentVerifierRegistryRoot) ||
+        !hex32(mutation.newVerifierRegistryRoot)) {
+      return fail('PRF_AUTHORITY_TRANSITION_INVALID_RESULT', 'PRF returned non-canonical mutation fields');
+    }
+    return mutation as unknown as PrfAuthorityMutation;
+  });
+  return {
+    schema: 'prf-authority-transition-verification.v1',
+    verifierCommand: ['clojure', ...args],
+    inputs: files.map((file, index) => ({
+      role: index === 0 ? 'transition-request' : 'trusted-transition-context',
+      path: path.relative(prfRoot, file),
+      sha256: createHash('sha256').update(fs.readFileSync(file)).digest('hex'),
+    })),
+    output: result.stdout ?? '',
+    outputSha256: createHash('sha256').update(result.stdout ?? '', 'utf8').digest('hex'),
+    scope,
+    decisionPreimagesRoot: parsed['decision-preimages-root'] as string,
+    executionMutationRoot: parsed['execution-mutation-root'] as string,
+    mutations,
+    attestation: parsed.attestation as `0x${string}`,
+  };
+}
diff --git a/src/deployment/prf-evidence-replay.ts b/src/deployment/prf-evidence-replay.ts
new file mode 100644
index 0000000..8479eb2
--- /dev/null
+++ b/src/deployment/prf-evidence-replay.ts
@@ -0,0 +1,174 @@
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { createHash } from 'crypto';
+import { spawnSync } from 'child_process';
+import { canonicalJson } from '../canonical-json';
+import { ConfigError } from '../errors';
+import type { DeploymentManifest } from './manifest';
+
+type EvidenceAssertion = { id: string; status: string; detail?: string };
+type CommandRunner = (command: string, args: string[], options: { cwd: string; encoding: 'utf8' }) => {
+  status: number | null; error?: Error; stdout?: string; stderr?: string;
+};
+
+const digest = (value: string): string => createHash('sha256').update(value, 'utf8').digest('hex');
+const fail = (message: string): never => { throw new ConfigError('PLAN_EXECUTION_PRF_EVIDENCE_MISMATCH', message); };
+
+function parseEvidence(assertion: EvidenceAssertion | undefined, id: string): Record<string, unknown> {
+  if (!assertion || assertion.status !== 'passed' || !assertion.detail) return fail(`Required PRF assertion '${id}' is absent or not passed`);
+  try { return JSON.parse(assertion.detail) as Record<string, unknown>; }
+  catch { return fail(`Retained PRF assertion '${id}' is not valid JSON`); }
+}
+
+function retainedFiles(root: string, trustedContextRoot: string, evidence: Record<string, unknown>, expectedRoles: string[]): string[] {
+  const inputs = evidence.inputs as Array<{ role?: unknown; path?: unknown; sha256?: unknown }> | undefined;
+  if (!Array.isArray(inputs) || inputs.length !== expectedRoles.length) return fail('Retained PRF evidence has an incomplete input list');
+  const files: string[] = [];
+  for (let i = 0; i < inputs.length; i += 1) {
+    const input = inputs[i]!;
+    if (input.role !== expectedRoles[i] || typeof input.path !== 'string' || typeof input.sha256 !== 'string' || !/^[0-9a-f]{64}$/.test(input.sha256)) {
+      return fail(`Retained PRF evidence input ${i} has a missing or unexpected role, path, or digest`);
+    }
+    const relative = path.normalize(input.path);
+    if (path.isAbsolute(relative) || relative === '.' || relative === '..' || relative.startsWith(`..${path.sep}`)) return fail('Retained PRF evidence input escapes its source root');
+    const isTrustedContext = input.role === 'trusted-context' || input.role === 'trusted-transition-context';
+    const base = isTrustedContext ? trustedContextRoot : root;
+    const file = path.resolve(base, relative);
+    const contained = path.relative(base, file);
+    if (!contained || contained.startsWith(`..${path.sep}`) || contained === '..' || path.isAbsolute(contained)) return fail('Retained PRF evidence input escapes its source root');
+    let stat: fs.Stats;
+    try { stat = fs.statSync(file); } catch { return fail(`Retained PRF input '${input.path}' is unavailable`); }
+    let realBase: string;
+    let realFile: string;
+    try { realBase = fs.realpathSync(base); realFile = fs.realpathSync(file); }
+    catch { return fail(`Retained PRF input '${input.path}' cannot be resolved safely`); }
+    const realRelative = path.relative(realBase, realFile);
+    if (realRelative === '..' || realRelative.startsWith(`..${path.sep}`) || path.isAbsolute(realRelative) ||
+        !stat.isFile() || createHash('sha256').update(fs.readFileSync(file)).digest('hex') !== input.sha256) {
+      return fail(`Retained PRF input '${input.path}' does not match its authenticated digest`);
+    }
+    files.push(isTrustedContext ? file : relative);
+  }
+  return files;
+}
+
+function invoke(root: string, args: string[], expectedOutput: unknown, run: CommandRunner): void {
+  const result = run('clojure', args, { cwd: root, encoding: 'utf8' });
+  if (result.error || result.status !== 0) return fail(`Independent PRF replay failed: ${(result.stderr ?? result.stdout ?? result.error?.message ?? '').slice(-2000)}`);
+  let observed: unknown;
+  try { observed = JSON.parse(result.stdout ?? ''); } catch { return fail('Independent PRF replay returned malformed JSON'); }
+  if (canonicalJson(observed) !== canonicalJson(expectedOutput)) return fail('Independent PRF replay output differs from retained evidence');
+}
+
+/** Re-run deterministic PRF approval and root derivations from retained inputs. */
+export function replayRetainedPrfEvidence(
+  manifest: DeploymentManifest,
+  prfRoot: string,
+  trustedContextRoot: string,
+  rpcUrl?: string,
+  run: CommandRunner = (command, args, options) => spawnSync(command, args, options),
+): number {
+  const root = path.resolve(prfRoot);
+  const trustedRoot = path.resolve(trustedContextRoot);
+  try { if (!fs.statSync(trustedRoot).isDirectory()) return fail('Trusted-context root is not a directory'); }
+  catch { return fail('Trusted-context root is unavailable'); }
+  const assertions = manifest.finalAssertions as EvidenceAssertion[];
+  const byId = (id: string): EvidenceAssertion | undefined => assertions.find((assertion) => assertion.id === id && assertion.status === 'passed');
+  let replayed = 0;
+
+  const replayFileVerifier = (id: string, roles: string[], namespace: string, mode: string, required = false) => {
+    const assertion = byId(id);
+    if (!assertion && !required) return;
+    const evidence = parseEvidence(assertion, id);
+    const output = evidence.output;
+    if (typeof output !== 'string' || evidence.outputSha256 !== digest(output)) return fail(`Retained PRF output digest for '${id}' is invalid`);
+    const files = retainedFiles(root, trustedRoot, evidence, roles);
+    const parsedOutput = (() => { try { return JSON.parse(output) as unknown; } catch { return fail(`Retained PRF output for '${id}' is malformed`); } })();
+    invoke(root, ['-M:test', '-m', namespace, mode, ...files], parsedOutput, run);
+    replayed += 1;
+  };
+
+  replayFileVerifier('prf-initial-input-approval', ['manifest', 'package-set', 'trusted-context', 'approval-envelope'],
+    'scripts.deployment.configuration-review', 'verify-json', true);
+  if (byId('prf-successor-transition-approval')) {
+    replayFileVerifier('prf-successor-transition-approval', ['transition-manifest', 'verifier-registry', 'trusted-context', 'approval-envelope'],
+      'scripts.deployment.successor-transition-review', 'verify-json');
+  }
+  if (byId('prf-authority-transition-verification')) {
+    replayFileVerifier('prf-authority-transition-verification', ['transition-request', 'trusted-transition-context'],
+      'scripts.deployment.authority-transition-review', 'verify-json');
+  }
+
+  const replayRequest = (id: string, namespace: string, mode: string, request: unknown, output: unknown) => {
+    const temp = fs.mkdtempSync(path.join(os.tmpdir(), 'prf-evidence-replay-'));
+    const requestPath = path.join(temp, 'request.json');
+    try {
+      fs.writeFileSync(requestPath, JSON.stringify(request), { flag: 'wx', mode: 0o600 });
+      const evidence = parseEvidence(byId(id), id);
+      if (typeof evidence.output !== 'string' || evidence.outputSha256 !== digest(evidence.output) ||
+          canonicalJson(JSON.parse(evidence.output)) !== canonicalJson(output)) return fail(`Retained PRF output for '${id}' is inconsistent`);
+      invoke(root, ['-M:test', '-m', namespace, mode, requestPath], output, run);
+      replayed += 1;
+    } finally { fs.rmSync(temp, { recursive: true, force: true }); }
+  };
+
+  if (byId('prf-successor-registry-derivation')) {
+    const registry = parseEvidence(byId('prf-successor-registry-derivation'), 'prf-successor-registry-derivation');
+    let registryOutput: unknown;
+    try { registryOutput = typeof registry.output === 'string' ? JSON.parse(registry.output) as unknown : undefined; }
+    catch { return fail('Retained successor-registry derivation output is malformed'); }
+    const registryEntry = registry.entry;
+    if (!registryEntry || typeof registry.root !== 'string' || registry.solidityRoot !== registry.root ||
+        typeof registry.output !== 'string' || registry.outputSha256 !== digest(registry.output) ||
+        registry.requestSha256 !== digest(JSON.stringify({ schema: 'prf-verifier-registry-derivation-request.v1', entries: [registryEntry] }))) {
+      return fail('Retained successor-registry derivation request or output digest is invalid');
+    }
+    replayRequest('prf-successor-registry-derivation', 'scripts.deployment.registry-equivalence', 'derive-json',
+      { schema: 'prf-verifier-registry-derivation-request.v1', entries: [registryEntry] }, registryOutput);
+  }
+
+  if (byId('prf-successor-configuration-derivation')) {
+    const successor = parseEvidence(byId('prf-successor-configuration-derivation'), 'prf-successor-configuration-derivation');
+    const request = successor.request;
+    const derivation = successor.derivation;
+    if (!request || typeof request !== 'object' || !derivation || typeof derivation !== 'object' ||
+        successor.requestSha256 !== digest(JSON.stringify(request)) || successor.outputSha256 !== digest(String(successor.output))) {
+      return fail('Retained C0 to C1 derivation request or output digest is invalid');
+    }
+    replayRequest('prf-successor-configuration-derivation', 'scripts.deployment.successor-configuration', 'derive-json', request, derivation);
+  }
+
+  if (byId('prf-genesis-seal-result')) {
+    if (!rpcUrl) return fail('Genesis seal evidence requires --rpc-url for independent receipt and historical readback verification');
+    const preflight = parseEvidence(byId('prf-genesis-seal-preflight'), 'prf-genesis-seal-preflight');
+    const resultEvidence = parseEvidence(byId('prf-genesis-seal-result'), 'prf-genesis-seal-result');
+    const preflightOutput = preflight.output;
+    const resultOutput = resultEvidence.output;
+    if (typeof preflightOutput !== 'string' || preflight.outputSha256 !== digest(preflightOutput) ||
+        typeof resultOutput !== 'string' || resultEvidence.outputSha256 !== digest(resultOutput)) {
+      return fail('Retained genesis preflight or seal-result output digest is invalid');
+    }
+    const inputs = resultEvidence.inputs as Array<{ role?: unknown; path?: unknown; sha256?: unknown }> | undefined;
+    if (!Array.isArray(inputs) || inputs.length !== 3 || inputs[2]?.role !== 'preflight-verifier-output' ||
+        inputs[2]?.path !== 'captured-before-signing' || inputs[2]?.sha256 !== digest(preflightOutput)) {
+      return fail('Genesis seal-result evidence is not bound to its retained preflight output');
+    }
+    const fileInputs = { ...resultEvidence, inputs: inputs.slice(0, 2) };
+    const files = retainedFiles(root, trustedRoot, fileInputs, ['preflight-request', 'trusted-context']);
+    const genesis = manifest.contracts.find((contract) => contract.logicalId === 'prf/genesis');
+    const authority = manifest.contracts.find((contract) => contract.logicalId === 'prf/governance-authority');
+    const action = manifest.bootstrapActions.find((candidate) => candidate.id === 'prf/seal-genesis' && candidate.status === 'verified');
+    if (!genesis || !authority || !action?.transactionHash) return fail('Genesis seal result lacks its manifested contracts or verified seal action');
+    const temp = fs.mkdtempSync(path.join(os.tmpdir(), 'prf-seal-result-replay-'));
+    const preflightPath = path.join(temp, 'preflight.json');
+    try {
+      fs.writeFileSync(preflightPath, preflightOutput, { flag: 'wx', mode: 0o600 });
+      const args = ['-M:test', '-m', 'scripts.deployment.genesis-seal-gate', 'verify-seal-result',
+        files[0]!, files[1]!, preflightPath, rpcUrl, action.transactionHash, genesis.address, authority.address, '--json'];
+      invoke(root, args, JSON.parse(resultOutput) as unknown, run);
+      replayed += 1;
+    } finally { fs.rmSync(temp, { recursive: true, force: true }); }
+  }
+  return replayed;
+}
diff --git a/src/deployment/prf-genesis-seal-preflight.ts b/src/deployment/prf-genesis-seal-preflight.ts
new file mode 100644
index 0000000..f24466d
--- /dev/null
+++ b/src/deployment/prf-genesis-seal-preflight.ts
@@ -0,0 +1,172 @@
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { createHash } from 'crypto';
+import { spawnSync } from 'child_process';
+import { ConfigError } from '../errors';
+
+export interface PrfGenesisSealPreflightInput {
+  prfRoot: string;
+  requestPath: string;
+  trustedContextPath: string;
+  rpcUrl: string;
+  genesisAddress: string;
+  authorityAdapterAddress: string;
+  expectedCall: { from: string; target: string; function: string; args: unknown[] };
+  expectedManifestRoot: string;
+}
+
+export interface PrfGenesisSealPreflightEvidence {
+  schema: 'prf-chain-instance-seal-preflight.v2';
+  qualification: 'approved-inputs-and-live-observations-verified';
+  manifestRoot: string;
+  sourceTreeSha256: string;
+  computedRoot: string;
+  sealCall: { from: string; target: string; function: string; args: string[] };
+  derivedArguments: string[];
+  observationBlocks: unknown;
+  sourceFileCount: number;
+  verifierCommand: string[];
+  inputs: Array<{ role: string; path: string; sha256: string }>;
+  output: string;
+  outputSha256: string;
+}
+
+export interface PrfGenesisSealResultEvidence {
+  schema: 'prf-chain-instance-seal-result.v1';
+  qualification: 'seal-receipt-and-readback-verified';
+  manifestRoot: string;
+  chainInstanceGenesisRoot: string;
+  receipt: unknown;
+  preflightOutputSha256: string;
+  verifierCommand: string[];
+  inputs: Array<{ role: string; path: string; sha256: string }>;
+  output: string;
+  outputSha256: string;
+}
+
+/** Independently run PRF's live observation and canonical genesis preflight.
+ * The result is bound to the exact bootstrap calldata before signing. */
+export function verifyPrfGenesisSealPreflight(
+  input: PrfGenesisSealPreflightInput,
+  run: (command: string, args: string[], options: { cwd: string; encoding: 'utf8' }) => { status: number | null; error?: Error; stdout?: string; stderr?: string } =
+    (command, args, options) => spawnSync(command, args, options),
+): PrfGenesisSealPreflightEvidence {
+  const prfRoot = path.resolve(input.prfRoot);
+  const files = [input.requestPath, input.trustedContextPath].map((file) => path.resolve(prfRoot, file));
+  for (const file of files) {
+    try {
+      if (!fs.statSync(file).isFile()) throw new Error('not a regular file');
+    } catch (error) {
+      throw new ConfigError('PRF_GENESIS_SEAL_INPUT_INVALID', `Required PRF seal-preflight input is unavailable: ${path.relative(prfRoot, file)}`, {
+        path: file, details: { reason: error instanceof Error ? error.message : String(error) },
+      });
+    }
+  }
+  const args = ['-M:test', '-m', 'scripts.deployment.genesis-seal-gate', path.relative(prfRoot, files[0]!), path.relative(prfRoot, files[1]!), input.rpcUrl, input.genesisAddress, input.authorityAdapterAddress, '--json'];
+  const result = run('clojure', args, { cwd: prfRoot, encoding: 'utf8' });
+  if (result.error || result.status !== 0) {
+    throw new ConfigError('PRF_GENESIS_SEAL_PREFLIGHT_REJECTED', 'PRF rejected live genesis-seal preflight or its verifier could not run', {
+      details: { exitCode: result.status, error: result.error?.message, output: (result.stderr ?? result.stdout ?? '').slice(-4000) },
+    });
+  }
+  const output = result.stdout ?? '';
+  let parsed: Record<string, unknown>;
+  try { parsed = JSON.parse(output) as Record<string, unknown>; }
+  catch { throw new ConfigError('PRF_GENESIS_SEAL_PREFLIGHT_INVALID_RESULT', 'PRF seal gate returned malformed structured output'); }
+  const call = parsed['seal-call'] as Record<string, unknown> | undefined;
+  const callArgs = Array.isArray(call?.args) ? call.args.map(String) : [];
+  const expectedArgs = input.expectedCall.args.map((value) => value === undefined
+    ? undefined
+    : typeof value === 'string' ? value.replace(/^0x/, '').toLowerCase() : String(value));
+  const sameCall = Boolean(call) &&
+    String(call!.from).toLowerCase() === input.expectedCall.from.toLowerCase() &&
+    String(call!.target).toLowerCase() === input.expectedCall.target.toLowerCase() &&
+    call!.function === input.expectedCall.function &&
+    callArgs.length === expectedArgs.length &&
+    callArgs.every((value, index) => expectedArgs[index] === undefined || value.replace(/^0x/, '').toLowerCase() === expectedArgs[index]);
+  if (parsed.schema !== 'prf-chain-instance-seal-preflight.v2' ||
+      parsed.qualification !== 'approved-inputs-and-live-observations-verified' ||
+      parsed['manifest-root'] !== input.expectedManifestRoot ||
+      !sameCall || typeof parsed['computed-root'] !== 'string' || typeof parsed['source-tree-sha256'] !== 'string' ||
+      typeof parsed['observations-edn'] !== 'string' || !Number.isInteger(parsed['source-file-count'])) {
+    throw new ConfigError('PRF_GENESIS_SEAL_PREFLIGHT_INVALID_RESULT', 'PRF seal preflight does not match the approved manifest and exact planned bootstrap call', {
+      details: { schema: parsed.schema, qualification: parsed.qualification, manifestRoot: parsed['manifest-root'], expectedManifestRoot: input.expectedManifestRoot, expectedCall: input.expectedCall, observedCall: call },
+    });
+  }
+  const roles = ['preflight-request', 'trusted-context'];
+  return {
+    schema: 'prf-chain-instance-seal-preflight.v2',
+    qualification: 'approved-inputs-and-live-observations-verified',
+    manifestRoot: String(parsed['manifest-root']),
+    sourceTreeSha256: String(parsed['source-tree-sha256']),
+    computedRoot: String(parsed['computed-root']),
+    sealCall: call as PrfGenesisSealPreflightEvidence['sealCall'],
+    derivedArguments: callArgs.map((value) => `0x${value.replace(/^0x/, '')}`),
+    observationBlocks: parsed['observation-blocks'],
+    sourceFileCount: Number(parsed['source-file-count']),
+    verifierCommand: ['clojure', ...args],
+    inputs: files.map((file, index) => ({ role: roles[index]!, path: path.relative(prfRoot, file), sha256: createHash('sha256').update(fs.readFileSync(file)).digest('hex') })),
+    output,
+    outputSha256: createHash('sha256').update(output, 'utf8').digest('hex'),
+  };
+}
+
+/** Independently verify the mined seal transaction and same-block post-state. */
+export function verifyPrfGenesisSealResult(
+  input: Omit<PrfGenesisSealPreflightInput, 'expectedCall'> & { transactionHash: string; expectedGenesisRoot: string; preflightOutput: string },
+  run: (command: string, args: string[], options: { cwd: string; encoding: 'utf8' }) => { status: number | null; error?: Error; stdout?: string; stderr?: string } =
+    (command, args, options) => spawnSync(command, args, options),
+): PrfGenesisSealResultEvidence {
+  const prfRoot = path.resolve(input.prfRoot);
+  const files = [input.requestPath, input.trustedContextPath].map((file) => path.resolve(prfRoot, file));
+  for (const file of files) {
+    try {
+      if (!fs.statSync(file).isFile()) throw new Error('not a regular file');
+    } catch (error) {
+      throw new ConfigError('PRF_GENESIS_SEAL_INPUT_INVALID', `Required PRF seal-result input is unavailable: ${path.relative(prfRoot, file)}`, {
+        path: file, details: { reason: error instanceof Error ? error.message : String(error) },
+      });
+    }
+  }
+  const tempRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'prf-genesis-seal-result-'));
+  const preflightPath = path.join(tempRoot, 'preflight.json');
+  fs.writeFileSync(preflightPath, input.preflightOutput, { flag: 'wx', mode: 0o600 });
+  const args = ['-M:test', '-m', 'scripts.deployment.genesis-seal-gate', 'verify-seal-result', path.relative(prfRoot, files[0]!), path.relative(prfRoot, files[1]!), preflightPath, input.rpcUrl, input.transactionHash, input.genesisAddress, input.authorityAdapterAddress, '--json'];
+  let result: ReturnType<typeof run>;
+  try { result = run('clojure', args, { cwd: prfRoot, encoding: 'utf8' }); }
+  finally { fs.rmSync(tempRoot, { recursive: true, force: true }); }
+  if (result.error || result.status !== 0) {
+    throw new ConfigError('PRF_GENESIS_SEAL_RESULT_REJECTED', 'PRF could not verify the mined seal receipt and same-block readback', {
+      details: { exitCode: result.status, error: result.error?.message, output: (result.stderr ?? result.stdout ?? '').slice(-4000) },
+    });
+  }
+  const output = result.stdout ?? '';
+  let parsed: Record<string, unknown>;
+  try { parsed = JSON.parse(output) as Record<string, unknown>; }
+  catch { throw new ConfigError('PRF_GENESIS_SEAL_RESULT_INVALID', 'PRF seal-result verifier returned malformed structured output'); }
+  const root = parsed['chain-instance-genesis-root'];
+  const manifestRoot = parsed['manifest-root'];
+  if (parsed.schema !== 'prf-chain-instance-seal-result.v1' ||
+      parsed.qualification !== 'seal-receipt-and-readback-verified' ||
+      manifestRoot !== input.expectedManifestRoot || root !== input.expectedGenesisRoot) {
+    throw new ConfigError('PRF_GENESIS_SEAL_RESULT_INVALID', 'PRF seal-result evidence does not match approved inputs or the preflight-derived root', {
+      details: { schema: parsed.schema, qualification: parsed.qualification, manifestRoot, expectedManifestRoot: input.expectedManifestRoot, root, expectedGenesisRoot: input.expectedGenesisRoot },
+    });
+  }
+  return {
+    schema: 'prf-chain-instance-seal-result.v1',
+    qualification: 'seal-receipt-and-readback-verified',
+    manifestRoot: String(manifestRoot),
+    chainInstanceGenesisRoot: String(root),
+    receipt: parsed.receipt,
+    preflightOutputSha256: createHash('sha256').update(input.preflightOutput, 'utf8').digest('hex'),
+    verifierCommand: ['clojure', ...args],
+    inputs: [
+      ...files.map((file, index) => ({ role: index === 0 ? 'preflight-request' : 'trusted-context', path: path.relative(prfRoot, file), sha256: createHash('sha256').update(fs.readFileSync(file)).digest('hex') })),
+      { role: 'preflight-verifier-output', path: 'captured-before-signing', sha256: createHash('sha256').update(input.preflightOutput, 'utf8').digest('hex') },
+    ],
+    output,
+    outputSha256: createHash('sha256').update(output, 'utf8').digest('hex'),
+  };
+}
diff --git a/src/deployment/prf-initial-approval.ts b/src/deployment/prf-initial-approval.ts
new file mode 100644
index 0000000..22c36e4
--- /dev/null
+++ b/src/deployment/prf-initial-approval.ts
@@ -0,0 +1,142 @@
+import * as fs from 'fs';
+import * as path from 'path';
+import { createHash } from 'crypto';
+import { spawnSync } from 'child_process';
+import { ConfigError } from '../errors';
+
+export interface PrfInitialApprovalInput {
+  prfRoot: string;
+  manifestPath: string;
+  packageSetPath: string;
+  trustedContextPath: string;
+  approvalPath: string;
+}
+
+export interface PrfApprovalCommandResult {
+  status: number | null;
+  error?: Error;
+  stdout?: string;
+  stderr?: string;
+}
+
+export interface PrfInitialApprovalEvidence {
+  schema: 'prf-initial-input-approval-verification.v1';
+  verifierCommand: string[];
+  inputs: Array<{ role: string; path: string; sha256: string }>;
+  output: string;
+  outputSha256: string;
+  manifestRoot: string;
+  approvedRootBindings: PrfApprovedRootBindings;
+}
+
+export interface PrfApprovedRootBindings {
+  protocolGenesisRoot: string;
+  authorityStateRoot: string;
+  localAuthorityPolicyRoot: string;
+  initialConfigurationRoot: string;
+  initialVerifierRegistryRoot: string;
+  authorityTransitionValidatorAddress: string;
+}
+
+export type PrfApprovalCommand = (
+  command: string,
+  args: string[],
+  options: { cwd: string; encoding: 'utf8' },
+) => PrfApprovalCommandResult;
+
+/** Require PRF's independent content, source-lock, scope and signature verifier
+ * before a bounded deployment can send its first transaction. Trusted context
+ * remains a separate operator-controlled file. */
+export function verifyPrfInitialInputApproval(
+  input: PrfInitialApprovalInput,
+  run: PrfApprovalCommand = (command, args, options) => spawnSync(command, args, options),
+): PrfInitialApprovalEvidence {
+  const prfRoot = path.resolve(input.prfRoot);
+  const files = [input.manifestPath, input.packageSetPath, input.trustedContextPath, input.approvalPath]
+    .map((file) => path.resolve(prfRoot, file));
+  for (const file of files) {
+    let stat: fs.Stats;
+    try {
+      stat = fs.statSync(file);
+    } catch (error) {
+      throw new ConfigError('PRF_INITIAL_APPROVAL_INPUT_MISSING', `Required PRF initial-approval input is unavailable: ${path.relative(prfRoot, file)}`, {
+        path: file,
+        details: { reason: error instanceof Error ? error.message : String(error) },
+      });
+    }
+    if (!stat.isFile()) throw new ConfigError('PRF_INITIAL_APPROVAL_INPUT_INVALID', `PRF approval input is not a regular file: ${path.relative(prfRoot, file)}`, { path: file });
+  }
+  const [manifest, packageSet, trustedContext, approval] = files;
+  const relativeFiles = files.map((file) => path.relative(prfRoot, file));
+  const args = [
+    '-M:test', '-m', 'scripts.deployment.configuration-review', 'verify-json',
+    ...relativeFiles,
+  ];
+  const result = run('clojure', args, { cwd: prfRoot, encoding: 'utf8' });
+  if (result.error || result.status !== 0) {
+    throw new ConfigError('PRF_INITIAL_APPROVAL_REJECTED', 'PRF rejected the initial-input approval or could not run its independent verifier', {
+      details: {
+        exitCode: result.status,
+        error: result.error?.message,
+        output: (result.stderr ?? result.stdout ?? '').slice(-4000),
+      },
+    });
+  }
+  const roles = ['manifest', 'package-set', 'trusted-context', 'approval-envelope'];
+  const output = result.stdout ?? '';
+  let verification: {
+    valid?: unknown;
+    qualification?: unknown;
+    source?: { valid?: unknown };
+    'manifest-root'?: unknown;
+    'canonical-roots'?: Record<string, unknown>;
+    'initial-configuration'?: Record<string, unknown>;
+  'authority-transition-validator-address'?: unknown;
+  };
+  try {
+    verification = JSON.parse(output) as typeof verification;
+  } catch {
+    throw new ConfigError('PRF_INITIAL_APPROVAL_INVALID_RESULT', 'PRF verifier returned malformed structured output');
+  }
+  if (verification.valid !== true ||
+      verification.qualification !== 'authenticated-content-approval' ||
+      verification.source?.valid !== true ||
+      typeof verification['manifest-root'] !== 'string' ||
+      !/^sha256:[0-9a-f]{64}$/.test(verification['manifest-root'])) {
+    throw new ConfigError('PRF_INITIAL_APPROVAL_INVALID_RESULT', 'PRF verifier output does not prove authenticated source-bound initial-input approval');
+  }
+  const rootRef = (value: unknown, label: string): string => {
+    if (typeof value !== 'string' || !/^sha256:[0-9a-f]{64}$/.test(value)) {
+      throw new ConfigError('PRF_INITIAL_APPROVAL_INVALID_RESULT', `PRF verifier omitted the approved ${label} root`);
+    }
+    return `0x${value.slice('sha256:'.length)}`;
+  };
+  const roots = verification['canonical-roots'];
+  const initialConfiguration = verification['initial-configuration'];
+  if (!roots || !initialConfiguration) throw new ConfigError('PRF_INITIAL_APPROVAL_INVALID_RESULT', 'PRF verifier omitted the approved canonical root set');
+  const validatorAddress = verification['authority-transition-validator-address'];
+  if (typeof validatorAddress !== 'string' || !/^0x[0-9a-f]{40}$/.test(validatorAddress) || /^0x0{40}$/.test(validatorAddress)) {
+    throw new ConfigError('PRF_INITIAL_APPROVAL_INVALID_RESULT', 'PRF verifier omitted a valid policy-v3 transition-validator address');
+  }
+  const approvedRootBindings: PrfApprovedRootBindings = {
+    protocolGenesisRoot: rootRef(roots['protocol-genesis'], 'protocol genesis'),
+    authorityStateRoot: rootRef(roots['authority-state'], 'authority state'),
+    localAuthorityPolicyRoot: rootRef(roots['local-authority-policy'], 'local authority policy'),
+    initialConfigurationRoot: rootRef(roots['initial-configuration'], 'initial configuration'),
+    initialVerifierRegistryRoot: rootRef(initialConfiguration['verifier-registry/root'], 'empty verifier registry'),
+    authorityTransitionValidatorAddress: validatorAddress,
+  };
+  return {
+    schema: 'prf-initial-input-approval-verification.v1',
+    verifierCommand: ['clojure', ...args],
+    inputs: files.map((file, index) => ({
+      role: roles[index]!,
+      path: path.relative(prfRoot, file),
+      sha256: createHash('sha256').update(fs.readFileSync(file)).digest('hex'),
+    })),
+    output,
+    outputSha256: createHash('sha256').update(output, 'utf8').digest('hex'),
+    manifestRoot: verification['manifest-root'],
+    approvedRootBindings,
+  };
+}
