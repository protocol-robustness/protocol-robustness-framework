{:scenario-id "dr-c-005-appeal-bond-forfeit-reserve"
 :schema-version "1.0"
 :allow-open-disputes? true
 :purpose "behavioural-correction"
 :title "Forfeited appeal bonds tracked in reserve, not stranded"
 :description "When an appeal bond is explicitly forfeited or cleaned up on finalization, the principal must be tracked in the forfeited bond reserve rather than silently stranded. Verifies that forfeitedBondReserve increases by the forfeited amount and that tokens remain in the custody contract."
 :provenance {:author "@bond-ledger" :created-at "2026-07-30" :license "CC-BY-4.0"}
 :claim {:id "appeal-bond-forfeit-reserve"
         :statement "Forfeited appeal bond principal is recorded in a forfeitedBondReserve, preventing silent asset stranding."
         :falsifies-if ["Forfeited tokens are lost without accounting"
                        "Forfeited tokens are double-counted as claimable"
                        "Finalization cleanup does not track forfeited principal"]}
 :expectations {:terminal-state "released"
                :must-hold ["forfeited_reserve_tracked"]
                :metrics {:forfeited_reserve {:gt 0}
                          :custody_preserved true}}
 :threat {:family "bond-lifecycle" :attack "stranded-assets" :severity "medium"
          :actors ["challenger"]
          :assumptions ["escalation-cost-enabled"]}
 :accounting {:unit "USDC" :decimals 6 :tracked-balances ["protocol"]}
 :initial-block-time 1000
 :protocol-params {:resolver-fee-bps 150 :appeal-window-duration 60 :max-dispute-duration 2592000 :appeal-bond-bps 500 :dispute-resolver "0xl0" :escalation-resolvers {:0 "0xl0" :1 "0xl1"}}
 :agents [{:id "buyer" :address "0xbuyer" :strategy "honest"}
          {:id "seller" :address "0xseller" :strategy "honest"}
          {:id "l0resolver" :address "0xl0" :role "resolver"}
          {:id "challenger" :address "0xchallenger" :strategy "honest"}
          {:id "keeper" :address "0xkeeper" :role "keeper"}]
 :events [{:seq 0 :time 1000 :agent "buyer" :action "create_escrow"
           :params {:token "USDC" :to "0xseller" :amount 5000}}
          {:seq 1 :time 1060 :agent "seller" :action "raise_dispute" :params {:workflow-id 0}}
          {:seq 2 :time 1100 :agent "l0resolver" :action "execute_resolution"
           :params {:workflow-id 0 :is-release true :resolution-hash "0xhash0"}}
          {:seq 3 :time 1300 :agent "keeper" :action "execute_pending_settlement" :params {:workflow-id 0}}]}
