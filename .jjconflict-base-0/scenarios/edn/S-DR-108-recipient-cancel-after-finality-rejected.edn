{:scenario-id "s-dr-108-recipient-cancel-after-finality-rejected"
 :schema-version "1.0"
 :purpose "adversarial-robustness"
 :title "recipient-cancel after settlement finality is rejected — cancel cannot unwind a resolved escrow"
 :description "Strategic disputant behavior: after a dispute is resolved and the pending settlement executed (escrow released), the seller (recipient) attempts recipient_cancel. The escrow is in a terminal :released state, so the attempt is rejected with :transfer-not-pending — a counterparty cannot unwind a finalized settlement via cancel."
 :tags ["suite/dispute-resolution"
        "coverage/strategic"
        "coverage/cancel"
        "coverage/recipient-cancel"
        "coverage/finality"
        "coverage/terminal-state-guard"
        "recipient-cancel/after-finality"]
 :threat-tags ["dispute-resolution" "strategic" "cancel" "finality" "terminal-state"]
 :provenance {:author "strategic-disputant-model" :created-at "2026-08-10" :license "CC-BY-4.0"}
 :claim {:id "recipient-cancel-after-finality-rejected"
         :statement "recipient_cancel on a terminal (released) escrow is rejected with :transfer-not-pending; cancel cannot unwind a finalized settlement."
         :falsifies-if ["recipient_cancel succeeds after finality"
                        "cancel unwinds a resolved escrow"]}
 :expected-errors [{:seq 4 :action "recipient_cancel" :error "transfer-not-pending"}]
 :expectations {:terminal-state "released"}
 :expected/invariants [:stake/non-negative
                       :conservation-of-funds
                       :terminal-states-unchanged]
 :threat {:family "dispute-resolution" :attack "recipient-cancel-after-finality" :severity "medium"
          :actors ["seller"] :victims ["buyer"]
          :assumptions ["Escrow is :released (terminal)" "recipient_cancel requires :pending"]}
 :accounting {:unit "USDC" :decimals 6 :tracked-balances ["buyer" "seller" "protocol"]}
 :initial-block-time 1000
 :protocol-params {:resolver-fee-bps 150 :dispute-resolver "0xresolver"}
 :agents [{:id "buyer" :address "0xbuyer" :strategy "honest"}
          {:id "seller" :address "0xseller" :strategy "honest"}
          {:id "resolver" :address "0xresolver" :role "resolver" :stake 10000}
          {:id "keeper" :address "0xkeeper" :role "keeper"}]
 :events [{:seq 0 :time 1000 :agent "resolver" :action "register_stake" :params {:amount 10000}}
          {:seq 1 :time 1000 :agent "buyer" :action "create_escrow" :params {:token "USDC" :to "0xseller" :amount 5000}}
          {:seq 2 :time 1060 :agent "buyer" :action "raise_dispute" :params {:workflow-id 0}}
          {:seq 3 :time 1120 :agent "resolver" :action "execute_resolution" :params {:workflow-id 0 :is-release true :resolution-hash "0xrelease"}}
          {:seq 4 :time 1260 :agent "seller" :action "recipient_cancel" :params {:workflow-id 0}}]}
