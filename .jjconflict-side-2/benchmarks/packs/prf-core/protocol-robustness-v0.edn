{:benchmark/id              :benchmark/prf-protocol-robustness-v0
  :benchmark/version         0
  :benchmark/status          :experimental
  :benchmark/coverage-status :partial
  :benchmark/experimental-reason
  "The named resolver-accountability, adversarial-liveness, and fund-safety
   claims are deferred semantic claims. This is a research profile over
   representative workloads, not scored assurance for those properties."
  :benchmark/domain          :domain/escrow-dispute-resolution
  :benchmark/protocol        :protocol/prf
   :benchmark/scenario-suite  :suite/reference-validation-v1
   :benchmark/suite-pinned-version "1.3.0"
  :benchmark/scenario-suite-description
  "Three Sew reference-validation scenarios: S25_profit-maximizer-slash-lifecycle,
   S62_resolver-throughput-exhaustion, and S05_pending-settlement-execute. These are
   simulator-backed scenarios that exercise resolver accountability,
   liveness under adversarial load, and pull-first fund safety."
 :benchmark/runner-policy   :runner-policy/deterministic-local-v1
 :benchmark/evidence-policy :evidence-policy/forensic-standard-v1
   :benchmark/scoring-rule    :scoring/robustness-dimensions-v0
    :benchmark/property-types  #{:integrity :safety :liveness}
    :benchmark/description
   "Experimental protocol-robustness research profile across three scenario-tested dimensions
    (resolver accountability, liveness under adversarial load, fund safety
    through pull-first settlement) plus a cross-cutting evidence-integrity
    concept. Uses :suite/reference-validation-v1 (3 simulator-backed
    scenarios) with explicit per-scenario dimension mapping. Semantic
    claims per dimension are deferred (Level 3) — see :benchmark/deferred-scenario-claims."
    :benchmark/deferred-scenario-claims #{:malicious-verdict-economically-bounded
                                         :liveness-under-adversarial-load
                                         :pull-first-settlement-safety}
   :benchmark/purpose
  "Explore protocol robustness across three scenario-tested dimensions
   (resolver accountability, liveness under adversarial load, fund safety
   through pull-first settlement) plus a cross-cutting evidence-integrity
   concept. Each dimension maps to a representative scenario from the Sew
   reference-validation suite."
  :benchmark/concepts       [:robustness/resolver-accountability
                             :robustness/liveness-under-load
                             :robustness/escrow-fund-safety
                             :robustness/evidence-integrity
                             :forensic/evidence-chain
                             :concept/conservation
                             :concept/confidence
                             :concept/configuration]
  ;; :scenario/id must reference the suite's PUBLIC scenario ids
  ;; (:suite/reference-validation-v1), not the underlying simulator file
  ;; slugs. The public id is what the runner emits as :scenario/id and what
  ;; evidence records carry, so the benchmark's declared scenarios must match.
  :benchmark/scenarios
  [{:scenario/id "S25_profit-maximizer-slash-lifecycle"
    :dimension   :robustness/resolver-accountability
    :claim       :malicious-verdict-economically-bounded}
   {:scenario/id "S62_resolver-throughput-exhaustion"
    :dimension   :robustness/liveness-under-load
    :claim       :liveness-under-adversarial-load}
   {:scenario/id "S05_pending-settlement-execute"
    :dimension   :robustness/escrow-fund-safety
    :claim       :pull-first-settlement-safety}]
  :benchmark/claims
  [{:claim/id :evidence-root-present
    :claim/role :primary
    :claim/rationale "Every scenario must produce an evidence root hash to be verifiable."
    :claim/failure-meaning "Scenario evidence root is missing or nil."}
   {:claim/id :replay-result-present
    :claim/role :primary
    :claim/rationale "Replay must produce a result outcome for each scenario."
    :claim/failure-meaning "Scenario outcome is nil or missing from replay result."}
   {:claim/id :scenario-hash-present
    :claim/role :primary
    :claim/rationale "Evidence root must be a valid SHA-256 hex string for reproducible verification."
    :claim/failure-meaning "Evidence root is not a valid 64-char hex string."}
   {:claim/id :no-invariant-errors
    :claim/role :supporting
    :claim/rationale "No post-hoc invariants should fail during protocol execution."
    :claim/failure-meaning "One or more post-hoc invariants reported a failure."}
   {:claim/id :all-scenarios-pass
    :claim/role :primary
    :claim/rationale "All scenarios in the suite must complete with a passing outcome."
    :claim/failure-meaning "One or more scenarios had a non-passing outcome."}]}
