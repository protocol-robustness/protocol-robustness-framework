+// SPDX-License-Identifier: Apache-2.0
+pragma solidity ^0.8.33;
+
+import {Test} from "forge-std/Test.sol";
+import {PrfVerifierRegistry} from "../src/core/PrfVerifierRegistry.sol";
+
+/// Runs the exact JSON fixture corpus also recomputed by PRF's Clojure tests.
+contract PrfRegistryEquivalenceTest is Test {
+    function test_PrfCanonicalFixtureCorpus() public {
+        string memory data = vm.readFile("test/fixtures/verifier-registry-equivalence.v1.json");
+        PrfVerifierRegistry registry = new PrfVerifierRegistry(address(this));
+        string[5] memory names = [string("empty"), "single", "multi", "reordered", "inactive"];
+        for (uint256 i; i < names.length; ++i) {
+            string memory prefix = string.concat(".cases.", names[i]);
+            bytes32 root = registry.computeCanonicalRoot(
+                vm.parseJsonBytes32Array(data, string.concat(prefix, ".ids")),
+                vm.parseJsonAddressArray(data, string.concat(prefix, ".adapters")),
+                vm.parseJsonBytes32Array(data, string.concat(prefix, ".vkeys")),
+                vm.parseJsonBytes32Array(data, string.concat(prefix, ".elfHashes")),
+                vm.parseJsonStringArray(data, string.concat(prefix, ".programIds")),
+                vm.parseJsonBytes32Array(data, string.concat(prefix, ".schemaHashes")),
+                vm.parseJsonBytes32Array(data, string.concat(prefix, ".publicValuesSchemas")),
+                vm.parseJsonBoolArray(data, string.concat(prefix, ".actives"))
+            );
+            assertEq(root, vm.parseJsonBytes32(data, string.concat(prefix, ".root")), names[i]);
+        }
+    }
+}
