{:scenario-id "dr-c-006-appeal-bond-distribution-failure-atomic"
 :schema-version "1.0"
 :allow-open-disputes? true
 :purpose "behavioural-correction"
 :title "Bond distribution failure atomically reverts the resolution"
 :description "When distributeAppealBond fails during recordResolution (e.g., bond already consumed), the entire resolution must revert. Verifies that no try/catch silently swallows distribution failures, and that resolution cannot complete without successful bond settlement."
 :provenance {:author "@bond-ledger" :created-at "2026-07-30" :license "CC-BY-4.0"}
 :claim {:id "appeal-bond-distribution-atomic"
         :statement "Bond distribution during recordResolution is atomic: if distribution fails, the resolution reverts."
         :falsifies-if ["Resolution succeeds despite bond distribution failure"
                        "Distribution failure is silently swallowed by try/catch"
                        "Bond state and resolution state become inconsistent"]}
 :expectations {:terminal-state "disputed"
                :must-hold ["resolution_reverted_on_bond_failure"]
                :metrics {:resolution_attempt_reverted true}}
 :threat {:family "bond-lifecycle" :attack "inconsistent-state" :severity "critical"
          :actors ["challenger"]
          :assumptions ["escalation-cost-enabled"]}
 :accounting {:unit "USDC" :decimals 6 :tracked-balances ["challenger"]}
 :initial-block-time 1000
 :protocol-params {:resolver-fee-bps 150 :appeal-window-duration 60 :max-dispute-duration 2592000 :appeal-bond-bps 500 :dispute-resolver "0xl0" :escalation-resolvers {:0 "0xl0" :1 "0xl1"}}
 :agents [{:id "buyer" :address "0xbuyer" :strategy "honest"}
          {:id "seller" :address "0xseller" :strategy "honest"}
          {:id "l0resolver" :address "0xl0" :role "resolver"}
          {:id "l1resolver" :address "0xl1" :role "resolver"}
          {:id "challenger" :address "0xchallenger" :strategy "honest"}
          {:id "keeper" :address "0xkeeper" :role "keeper"}]
 :events [{:seq 0 :time 1000 :agent "buyer" :action "create_escrow"
           :params {:token "USDC" :to "0xseller" :amount 5000}}
          {:seq 1 :time 1060 :agent "seller" :action "raise_dispute" :params {:workflow-id 0}}
          {:seq 2 :time 1100 :agent "l0resolver" :action "execute_resolution"
           :params {:workflow-id 0 :is-release true :resolution-hash "0xhash0"}}
          {:seq 3 :time 1120 :agent "challenger" :action "challenge_resolution" :params {:workflow-id 0}}
          ;; Attempt to resolve round 1 without valid bond should revert
          ;; This step is expected to fail, leaving dispute in prior state
          {:seq 4 :time 1150 :agent "l1resolver" :action "execute_resolution"
           :params {:workflow-id 0 :is-release false :resolution-hash "0xhash1"}
           :expect {:outcome :revert}}]}
