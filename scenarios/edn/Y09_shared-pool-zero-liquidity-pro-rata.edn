{:scenario-id "Y09_shared-pool-zero-liquidity-pro-rata"
 :id "Y09"
 :schema-version "1.1"
 :title "Shared-Pool Zero-Liquidity Pro-Rata Withdrawal"
 :purpose "functional-test"
 :threat-tags ["shortfall" "pro-rata" "partial-fill" "zero-liquidity"]
 :scenario-author "agent-c"
 :protocol "yield-v1"
 :initial-block-time 1000000
 :protocol-params {:yield-profile "aave-v3" :token "USDC" :focus-owner-id "0xAlice"}
 :agents [{:id "0xAlice" :address "0xAlice" :role "provider"}
          {:id "0xBob" :address "0xBob" :role "provider"}
          {:id "0xMallory" :address "0xMallory" :role "provider" :strategy "adversarial"}
          {:id "governance" :address "governance" :role "governance"}]
 :events [{:seq 0 :time 1000000 :agent "0xAlice" :action "yield_deposit" :params {:amount 1000 :token "USDC" :owner-id "0xAlice"}}
          {:seq 1 :time 1000000 :agent "0xBob" :action "yield_deposit" :params {:amount 2000 :token "USDC" :owner-id "0xBob"}}
          {:seq 2 :time 1000000 :agent "0xMallory" :action "yield_deposit" :params {:amount 500 :token "USDC" :owner-id "0xMallory"}}
          {:seq 3 :time 1100000 :agent "governance" :action "set-yield-risk"
           :params {:token "USDC" :shortfall {:available-ratio 0.0 :reason "complete-liquidity-loss"}}}
          {:seq 4 :time 1200000 :agent "0xMallory" :action "yield_withdraw_shared"
           :params {:token "USDC" :module-id "aave-v3"
                    :owner-ids ["0xMallory" "0xBob" "0xAlice"]
                    :allocation-mode "pro-rata"}}]
 :expectations {:metrics [{:name "yield/positions-count" :value 3}
                          {:name "yield/total-principal" :value 3500}
                          {:name "yield/focus-principal" :value 1000}
                          {:name "yield/available-ratio" :value 0.0}]}}
