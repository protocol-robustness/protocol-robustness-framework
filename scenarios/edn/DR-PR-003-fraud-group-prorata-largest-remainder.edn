{:schema-version "1.0"
 :scenario-id "dr-pr-003-fraud-group-prorata-largest-remainder"
 :scenario-title "Fraud-group pro-rata slash — deterministic largest-remainder rounding"
 :scenario-purpose "Verify deterministic quantized pro-rata slashing. Three equal-stake liable resolvers share a 10-unit obligation. The exact quota is 10/3 each; largest-remainder rounding allocates 4/3/3 using canonical resolver-ID ordering for the equal-remainder tie."
 :scenario-notes "Declared member input order is intentionally non-canonical. The immutable snapshot is sorted resolver-a, resolver-b, resolver-c. The one-unit rounding remainder is assigned to resolver-a, yielding proposal and execution rows 4/3/3."
 :tags ["suite/dispute-resolution" "coverage/slashing" "coverage/pro-rata" "coverage/rounding"]
 :threat-tags ["slash" "pro-rata" "rounding" "determinism"]
 :purpose "assurance"
 :initial-block-time 1000
 :protocol-params {:resolver-fee-bps 0
                   :resolver-bond-bps 0
                   :appeal-window-duration 60
                   :slash-epoch-cap-bps 10000
                   :max-dispute-duration 2592000
                   :governance-mode :restricted}
 :agents [{:id "buyer" :address "0xbuyer" :strategy "honest"}
          {:id "seller" :address "0xseller" :strategy "honest"}
          {:id "resolver-a" :address "0xresolver-a" :role "resolver"}
          {:id "resolver-b" :address "0xresolver-b" :role "resolver"}
          {:id "resolver-c" :address "0xresolver-c" :role "resolver"}
          {:id "governance" :address "0xgov" :role "governance"}
          {:id "keeper" :address "0xkeeper" :role "keeper"}]
 :events [{:seq 0 :time 1000 :agent "resolver-a" :action "register_stake" :params {:amount 100 :token "USDC"}}
          {:seq 1 :time 1000 :agent "resolver-b" :action "register_stake" :params {:amount 100 :token "USDC"}}
          {:seq 2 :time 1000 :agent "resolver-c" :action "register_stake" :params {:amount 100 :token "USDC"}}
          {:seq 3 :time 1010 :agent "buyer" :action "create_escrow" :params {:token "USDC" :to "0xseller" :amount 1000 :custom-resolver "0xresolver-b"}}
          {:seq 4 :time 1060 :agent "buyer" :action "raise_dispute" :params {:workflow-id 0}}
          {:seq 5 :time 1100 :agent "resolver-b" :action "execute_resolution" :params {:workflow-id 0 :is-release false :resolution-hash "0xrounding-resolution"}}
          {:seq 6 :time 1130 :agent "governance" :action "propose_fraud_group_slash"
           :params {:workflow-id 0 :liable-resolvers ["0xresolver-c" "0xresolver-a" "0xresolver-b"] :amount 10
                    :liability-justification {:kind :governance-declared-group-fraud :incident "dr-pr-003"}}
           :bind {:group-slash-id :slash-id}}
          {:seq 7 :time 1161 :agent "keeper" :action "execute_pending_settlement" :params {:workflow-id 0}}
          {:seq 8 :time 1200 :agent "keeper" :action "execute_fraud_group_slash"
           :params {:workflow-id 0 :slash-id {:from-binding :group-slash-id}}}]}
