{:schema-version "1.0",
 :scenario-id "s42-resolver-buyer-bribery-loop",
 :initial-block-time 1000,
 :agents
 [{:id "buyer", :address "0xbuyer", :strategy "malicious"}
  {:id "seller", :address "0xseller", :strategy "honest"}
  {:id "l0resolver",
   :address "0xl0",
   :strategy "malicious",
   :role "resolver"}
  {:id "l1resolver",
   :address "0xl1",
   :strategy "resolver",
   :role "resolver"}
  {:id "keeper",
   :address "0xkeeper",
   :strategy "keeper",
   :role "keeper"}],
 :protocol-params
 {"governance-mode" :legacy,
  "resolver-fee-bps" 150,
  "appeal-window-duration" 60,
  "max-dispute-duration" 2592000,
  "resolver-bond-bps" 0,
  "resolution-module" "0xkleros-proxy",
  "escalation-resolvers" {"0" "0xl0", "1" "0xl1", "2" "0xl2"}},
 :events
 [{:seq 0,
   :time 1000,
   :agent "buyer",
   :action "create_escrow",
   :params {:token "USDC", :to "0xseller", :amount 10000}}
  {:seq 1,
   :time 1060,
   :agent "buyer",
   :action "raise_dispute",
   :params {:workflow-id 0}}
  {:seq 2,
   :time 1120,
   :agent "l0resolver",
   :action "execute_resolution",
   :params
   {:workflow-id 0,
    :is-release false,
    :resolution-hash "0xbribe-hash",
    :adversarial? true}}
  {:seq 3,
   :time 1150,
   :agent "seller",
   :action "challenge_resolution",
   :params {:workflow-id 0}}
  {:seq 4,
   :time 1200,
   :agent "l1resolver",
   :action "execute_resolution",
   :params
   {:workflow-id 0,
    :is-release true,
    :resolution-hash "0xhonest-hash"}}
  {:seq 5,
   :time 1265,
   :agent "keeper",
   :action "execute_pending_settlement",
   :params {:workflow-id 0}}],
 :scenario-author "@grifma"}
