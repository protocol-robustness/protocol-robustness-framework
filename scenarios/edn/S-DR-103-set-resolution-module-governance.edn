{:scenario-id "s-dr-103-set-resolution-module-governance"
 :schema-version "1.0"
 :purpose "regression"
 :title "set-resolution-module — governance configures the resolution module, non-governance rejected"
 :description "Exercises the set-resolution-module governance action (previously zero scenario coverage): governance sets a resolution module address; a non-governance caller is rejected with :not-governance; an empty address is rejected with :invalid-module-address; a valid address updates the global :params :resolution-module."
 :tags ["suite/dispute-resolution"
        "coverage/resolver-integrity"
        "coverage/resolution-module"
        "coverage/governance"
        "set-resolution-module/basic"]
 :threat-tags ["dispute-resolution" "resolution-module" "governance" "configuration"]
 :provenance {:author "resolution-module-model" :created-at "2026-08-10" :license "CC-BY-4.0"}
 :claim {:id "set-resolution-module-governance"
         :statement "set-resolution-module is governance-gated: only governance may set the module, empty addresses are rejected, and a valid set updates the global module param."
         :falsifies-if ["Non-governance can set the resolution module"
                        "Empty module address is accepted"]}
 :expected/events [:module-configured]
 :expected/not-events [:unauthorized-configuration]
 :expectations {:terminal-state "pending"}
