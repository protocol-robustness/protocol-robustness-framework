{:scenario-id "ap-disp-001-single-terminal-disposition"
 :schema-version "1.0"
 :allow-open-disputes? true
 :purpose "primitive-native-assurance"
 :title "Appeal bond accepts exactly one terminal disposition"
 :claim-to {:claim/id :appeal-primitive-terminal-disposition-uniqueness
            :behavior :single-terminal-disposition
            :classification :primitive-native
            :evidence-kind :primitive-native
            :target {:protocol :sew :implementation :appeal-primitive :checkpoint/id :sew-sep-2026-appeal-candidate}
            :asserts [:one-disposition-only :conflicting-disposition-rejected :disposition-history-immutable]
            :requires [{:seq 5 :action "resolve_appeal" :expected-status :accepted}
                       {:seq 6 :action "resolve_appeal" :expected-status :rejected
                        :expected-cause :already-disposed}]
            :scope {:bond-id "appeal-bond:0:0xchallenger:0" :dispositions [:refund :forfeiture]}}
 :expectations {:metrics {:terminal_disposition_count {:eq 1}
                          :second_terminal_operation_reverted {:eq true}
                          :historical_disposition_unchanged {:eq true}}}
 :protocol-params {:governance/identity "0xgovernance" :resolver-fee-bps 150 :appeal-window-duration 60 :max-dispute-duration 2592000 :appeal-bond-bps 500 :dispute-resolver "0xl0" :escalation-resolvers {:0 "0xl0" :1 "0xl1"}}
 :agents [{:id "buyer" :address "0xbuyer"} {:id "seller" :address "0xseller"} {:id "challenger" :address "0xchallenger"} {:id "governance" :address "0xgovernance" :role "governance"} {:id "l0" :address "0xl0" :role "resolver"} {:id "l1" :address "0xl1" :role "resolver"}]
 :events [{:seq 0 :time 1000 :agent "buyer" :action "create_escrow" :params {:token "USDC" :to "0xseller" :amount 5000}}
          {:seq 1 :time 1060 :agent "buyer" :action "raise_dispute" :params {:workflow-id 0}}
          {:seq 2 :time 1100 :agent "l0" :action "execute_resolution" :params {:workflow-id 0 :is-release true :resolution-hash "0xl0"}}
          {:seq 3 :time 1120 :agent "challenger" :action "challenge_resolution" :params {:workflow-id 0}}
          {:seq 4 :time 1150 :agent "l1" :action "execute_resolution" :params {:workflow-id 0 :is-release false :resolution-hash "0xl1"}}
          {:seq 5 :time 1300 :agent "governance" :action "resolve_appeal" :params {:workflow-id 0 :upheld? true}}
          {:seq 6 :time 1310 :agent "governance" :action "resolve_appeal" :params {:workflow-id 0 :upheld? false} :expect {:outcome :revert}}]}
