{:scenario-id "s-dr-098-appeal-ev-under-deterred"
 :schema-version "1.0"
 :purpose "theory-falsification"
 :expected-fail? true
 :title "Appeal EV under-deterred — low appeal bond gives wrong resolvers positive appeal EV"
  :description "Falsifies the theory that frivolous appeals are economically deterred. With reversal-slash-bps=2500 and appeal-bond-bps=300, the breakeven uphold probability is 0.107. Under the default governance error-rate of 0.30, a wrong resolver's appeal has positive expected value: appealing is profitable even when the resolver is wrong. Extends the S-DR-075 finding (insufficient bond deterrence) to the appeal stage. The :appeal-decision-rationality equilibrium check should FAIL with wrong-rational."
  :scenario-notes "Calibration guidance: docs/findings/APPEAL_EV_CALIBRATION.md. At default governance (accuracy 0.7, error-rate 0.3), the safe appeal-bond-bps window at slash-bps 2500 is [1071, 5833]; 300 is far below the deterrence lower bound."
 :tags ["suite/dispute-resolution"
        "coverage/strategic"
        "coverage/appeal"
        "coverage/economic"
        "appeal-ev/under-deterred"
        "theory-falsification"]
 :threat-tags ["dispute-resolution" "appeal" "economic" "expected-value" "deterrence" "finding-6"]
 :provenance {:author "appeal-ev-model" :created-at "2026-08-09" :license "CC-BY-4.0"}
 :claim {:id "appeal-ev-under-deterred"
         :statement "At low appeal-bond relative to slash, wrong resolvers have positive expected value for appealing, so frivolous appeals are not deterred."
         :falsifies-if ["A wrong resolver would NOT rationally appeal at these parameters"
                        "Appeal bond adequately deters frivolous appeals at these parameters"]}
 :expected/events [:reversal-slash/proposed :reversal-slash/executed :appeal/opened :appeal/resolved]
 :expected/not-events [:reversal-slash/reversed]
 :expectations {:terminal-state "released"}
 :expected/invariants [:stake/non-negative
                       :slash/requested-equals-debited-plus-unmet-plus-reversed
                       :resolver/balances-conserved]
 :threat {:family "economic-fairness" :attack "appeal-ev-under-deterred" :severity "high"
          :actors ["l1resolver"] :victims ["protocol" "buyer"]
          :assumptions ["Governance accuracy 0.70" "Governance error-rate 0.30" "Appeal bond far below slash"]}
 :accounting {:unit "USDC" :decimals 6 :tracked-balances ["buyer" "seller" "l0resolver" "l1resolver" "l2resolver" "governance" "protocol" "slashPool" "insurance"]}
 :initial-block-time 1000
 :protocol-params {:governance-mode :legacy, :resolver-fee-bps 150 :appeal-window-duration 120 :max-dispute-duration 2592000
                   :reversal-slash-bps 2500 :appeal-bond-bps 300
