{:schema-version "1.0"
 :scenario-id "dr-pr-001-fraud-group-prorata-appeal-stay"
 :scenario-title "Fraud-group pro-rata slash — upheld member appeal stays immutable share"
 :scenario-purpose "Verify an incident-scoped two-resolver fraud-group slash: liability is allocated from the immutable 100/300 stake snapshot, one member appeal is upheld, that member's 50 debit stays, and the remaining 150 debit is not increased or redistributed."
 :scenario-notes "The expected execution result is: resolver-a allocated 50, collected 0, stayed 50; resolver-b allocated and collected 150. The group slash remains an obligation of 200 with 50 unmet due to the upheld individual appeal."
 :tags ["suite/dispute-resolution" "coverage/slashing" "coverage/pro-rata" "coverage/appeal"]
 :threat-tags ["slash" "pro-rata" "appeal" "custody"]
 :purpose "assurance"
 :initial-block-time 1000
 :protocol-params {:resolver-fee-bps 0
                   :resolver-bond-bps 0
                   :appeal-window-duration 60
                   :appeal-bond-bps 0
                   :slash-epoch-cap-bps 10000
                   :max-dispute-duration 2592000
                   :governance-mode :restricted}
 :agents [{:id "buyer" :address "0xbuyer" :strategy "honest"}
          {:id "seller" :address "0xseller" :strategy "honest"}
          {:id "resolver-a" :address "0xresolver-a" :role "resolver"}
          {:id "resolver-b" :address "0xresolver-b" :role "resolver"}
          {:id "governance" :address "0xgov" :role "governance"}
          {:id "keeper" :address "0xkeeper" :role "keeper"}]
 :events [{:seq 0 :time 1000 :agent "resolver-a" :action "register_stake" :params {:amount 100 :token "USDC"}}
          {:seq 1 :time 1000 :agent "resolver-b" :action "register_stake" :params {:amount 300 :token "USDC"}}
          {:seq 2 :time 1010 :agent "buyer" :action "create_escrow" :params {:token "USDC" :to "0xseller" :amount 1000 :custom-resolver "0xresolver-b"}}
          {:seq 3 :time 1060 :agent "buyer" :action "raise_dispute" :params {:workflow-id 0}}
          {:seq 4 :time 1100 :agent "resolver-b" :action "execute_resolution" :params {:workflow-id 0 :is-release false :resolution-hash "0xgroup-resolution"}}
          {:seq 5 :time 1130 :agent "governance" :action "propose_fraud_group_slash"
           :params {:workflow-id 0 :liable-resolvers ["0xresolver-a" "0xresolver-b"] :amount 200
                    :liability-justification {:kind :governance-declared-group-fraud :incident "dr-pr-001"}}
           :bind {:group-slash-id :slash-id}}
          {:seq 6 :time 1140 :agent "resolver-a" :action "appeal_fraud_group_slash"
           :params {:workflow-id 0 :slash-id {:from-binding :group-slash-id}}}
          {:seq 7 :time 1150 :agent "governance" :action "resolve_fraud_group_appeal"
           :params {:workflow-id 0 :slash-id {:from-binding :group-slash-id} :member "0xresolver-a" :upheld? true}}
          {:seq 8 :time 1161 :agent "keeper" :action "execute_pending_settlement" :params {:workflow-id 0}}
          {:seq 9 :time 1200 :agent "keeper" :action "execute_fraud_group_slash"
           :params {:workflow-id 0 :slash-id {:from-binding :group-slash-id}}}]}
