{:scenario-id "s-nc-001-freeze-active-dispute-negative-control"
 :schema-version "1.0"
 :purpose "negative-control"
 :title "Negative control: freeze-with-active-dispute is now blocked by protocol guard"
 :description "Executing a fraud slash on a resolver with an active disputed escrow is rejected by the protocol guard :freeze-blocked-active-dispute. This negative control now verifies that the guard fires instead of allowing the invariant violation."
 :scenario/profile :negative-control
 :fault/id :freeze-resolver-with-active-dispute
 :provenance {:author "PRF package-assurance tests"
              :license "CC-BY-4.0"
              :updated-at "2026-07-20"}
 :claim {:id "negative-control-freeze-active-dispute-guard"
         :statement "A fraud slash on a resolver with active disputed escrows is rejected by the protocol guard."
         :falsifies-if ["Fraud slash is not rejected with :freeze-blocked-active-dispute"
                        "Slash proceeds despite active disputed escrow"]}
 :initial-block-time 1000
 :protocol-params {:governance-mode :legacy, :resolver-fee-bps 150
                   :appeal-window-duration 120
                   :max-dispute-duration 2592000
                   :fraud-slash-bps 5000
                   :appeal-bond-bps 500}
 :agents [{:id "buyer" :address "0xbuyer" :strategy "honest"}
          {:id "seller" :address "0xseller" :strategy "honest"}
          {:id "resolver" :address "0xresolver" :role "resolver"}
          {:id "governance" :address "0xgov" :role "governance"}
          {:id "keeper" :address "0xkeeper" :role "keeper"}]
 :events [{:seq 0 :time 1000 :agent "resolver" :action "register_stake"
           :params {:amount 20000}}
          {:seq 1 :time 1000 :agent "buyer" :action "create_escrow"
           :params {:token "USDC" :to "0xseller" :amount 10000
                    :custom-resolver "0xresolver"}}
          {:seq 2 :time 1060 :agent "buyer" :action "raise_dispute"
           :params {:workflow-id 0}}
          {:seq 3 :time 1100 :agent "resolver" :action "execute_resolution"
           :params {:workflow-id 0 :is-release false :resolution-hash "0xhash"}}
          {:seq 4 :time 1200 :agent "governance" :action "propose_fraud_slash"
           :params {:workflow-id 0 :resolver-addr "0xresolver" :amount 3000}}
          {:seq 5 :time 1350 :agent "keeper" :action "execute_fraud_slash"
           :params {:workflow-id 0}}]}
