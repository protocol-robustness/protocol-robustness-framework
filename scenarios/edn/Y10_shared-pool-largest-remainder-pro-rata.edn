{:scenario-id "Y10_shared-pool-largest-remainder-pro-rata"
 :id "Y10"
 :schema-version "1.1"
 :title "Shared-Pool Largest-Remainder Pro-Rata Withdrawal"
 :purpose "functional-test"
 :threat-tags ["shortfall" "pro-rata" "partial-fill" "rounding" "determinism"]
 :scenario-author "agent-c"
 :protocol "yield-v1"
 :initial-block-time 1000000
 :protocol-params {:yield-profile "aave-v3" :token "USDC" :focus-owner-id "0xAlice"}
 :agents [{:id "0xAlice" :address "0xAlice" :role "provider"}
          {:id "0xBob" :address "0xBob" :role "provider"}
          {:id "0xCarol" :address "0xCarol" :role "provider"}
          {:id "governance" :address "governance" :role "governance"}]
 :events [{:seq 0 :time 1000000 :agent "0xAlice" :action "yield_deposit" :params {:amount 100 :token "USDC" :owner-id "0xAlice"}}
          {:seq 1 :time 1000000 :agent "0xBob" :action "yield_deposit" :params {:amount 100 :token "USDC" :owner-id "0xBob"}}
          {:seq 2 :time 1000000 :agent "0xCarol" :action "yield_deposit" :params {:amount 100 :token "USDC" :owner-id "0xCarol"}}
          {:seq 3 :time 1100000 :agent "governance" :action "set-yield-risk"
           :params {:token "USDC" :shortfall {:available-ratio 0.1 :reason "quantized-liquidity-limit"}}}
          {:seq 4 :time 1200000 :agent "governance" :action "yield_withdraw_shared"
           :params {:token "USDC" :module-id "aave-v3"
                    :owner-ids ["0xCarol" "0xBob" "0xAlice"]
                    :allocation-mode "pro-rata"}}]
 :expectations {:metrics [{:name "yield/positions-count" :value 3}
                          {:name "yield/total-principal" :value 300}
                          {:name "yield/focus-principal" :value 100}
                          {:name "yield/available-ratio" :value 0.1}]}}
