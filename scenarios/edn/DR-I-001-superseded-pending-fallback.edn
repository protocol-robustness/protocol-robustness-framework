{:scenario-id "dr-i-001-superseded-pending-fallback"
 :schema-version "1.0"
 :allow-open-disputes? true
 :purpose "adversarial-robustness"
 :title "Superseded pending settlement recovery: escalation archives pending, escalated resolver stalls, canonical recovery settles after the appeal window"
 :description "L0 resolver rules release, creating pending settlement. Participant escalates (clears pending, archives as superseded). The escalated resolver produces no replacement resolution. While the archived decision's appeal window is open nothing can execute it; once that window elapses with no replacement decision at the current level, ONE canonical eligibility rule (sm/eligible-superseded-pending) makes the authoritative superseded decision recoverable — identically for direct execute_pending_settlement callers and for keeper automation (automate_timed_actions)."
 :provenance {:author "@dispute-researcher" :created-at "2026-06-30" :license "CC-BY-4.0"}
 :claim {:id "superseded-pending-recovery-canonical"
         :statement "A superseded pending settlement is NOT executable while its appeal window is open or while a newer decision exists at the current level. Once the authoritative superseded decision's deadline has elapsed with no replacement decision produced, it becomes recoverable under a single canonical rule shared by direct execution and keeper automation — who invokes settlement does not change which transitions are admissible."
         :falsifies-if ["The superseded pending settlement executes before its appeal deadline has elapsed"
                        "An older same-level superseded decision executes when a newer one is authoritative"
                        "Direct execution and keeper automation disagree on whether a superseded decision is admissible"]}
 :expectations {:invariants ["finality_blocked_during_appeal" "dispute_level_bounded"]
                :terminal [{:path ["escrow-transfers" 0 "escrow-state"] :equals "disputed"}]
                :step-terminal [{:seq 3 :path ["dispute-levels" 0] :equals 1}
                                {:seq 3 :path ["pending-count"] :equals 0}]}
 :threat {:family "settlement-finality" :attack "superseded-pending-settlement-revival" :severity "high"
          :actors ["escalator"]
          :assumptions ["Escalation archives -> superseded pending"
                        "Escalated resolver does not produce resolution"]}
 :accounting {:unit "USDC" :decimals 6 :tracked-balances ["buyer" "seller" "l0resolver" "l1resolver" "protocol"]}
 :initial-block-time 1000
 :protocol-params {:resolver-fee-bps 150 :appeal-window-duration 120 :max-dispute-duration 600
                   :dispute-resolver "0xl0"
                   :escalation-resolvers {:0 "0xl0" :1 "0xl1"}}
 :agents [{:id "buyer" :address "0xbuyer" :strategy "honest"}
          {:id "seller" :address "0xseller" :strategy "honest"}
          {:id "l0resolver" :address "0xl0" :role "resolver"}
          {:id "l1resolver" :address "0xl1" :role "resolver"}
          {:id "keeper" :address "0xkeeper" :role "keeper"}]
 :events [{:seq 0 :time 1000 :agent "buyer" :action "create_escrow"
           :params {:token "USDC" :to "0xseller" :amount 5000}}
          {:seq 1 :time 1060 :agent "buyer" :action "raise_dispute" :params {:workflow-id 0}}
          ;; L0 resolves release — creates pending settlement
          {:seq 2 :time 1100 :agent "l0resolver" :action "execute_resolution"
           :params {:workflow-id 0 :is-release true :resolution-hash "0xl0release"}}
          ;; Escalate to L1 — archives pending settlement as superseded
          {:seq 3 :time 1120 :agent "seller" :action "escalate_dispute" :params {:workflow-id 0}}
           ;; L1 resolver does NOT produce a resolution
           ;; The escrow remains :disputed at level 1
           ;; Max-dispute-duration = 600, so at time 1660 the escrow auto-expires
           ;; Before that, once the L0 decision's appeal deadline (1100+120=1220)
           ;; elapses, the canonical recovery rule makes the archived decision
           ;; admissible — for direct callers and keeper automation alike.
          ]}
