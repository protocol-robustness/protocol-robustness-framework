{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ;; Resolve the Sew model from an immutable public source revision. The
        ;; subdirectory manifest pulls its framework dependency from the same
        ;; repository checkout, so consumers need no local workspace path.
        org.protocol-robustness/prf-sew-protocol-model
        {:git/url "https://github.com/protocol-robustness/protocol-robustness-framework.git"
         :git/sha "b94b091cfbaf46ec34ae2ade4920f9a3751e3097"
         :deps/root "packages/sew-protocol-model"}}
 :aliases {:test {:extra-paths ["test"]}}}
