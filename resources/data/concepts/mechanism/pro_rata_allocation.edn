  capped obligation rows while preserving conservation and canonical rounding."

 :concept/properties
 [:pro-rata/conservation
  :pro-rata/cap-respecting
  :pro-rata/allocation-complete
  :pro-rata/quota-bounded
  :pro-rata/canonical-remainder-assignment
  :pro-rata/permutation-invariant
  :pro-rata/duplicate-preserving]

 :concept/examples
 [{:domain :shared-withdrawal}
  {:domain :sew-pro-rata-slash}]

 :concept/guarantees
 [{:property :pro-rata/duplicate-preserving
   :enforcement :request-and-result-structure}
  {:property :pro-rata/cap-respecting
     :enforcement :claim-evaluator}
    {:property :pro-rata/canonical-remainder-assignment
     :enforcement :claim-evaluator}
  {:property :pro-rata/permutation-invariant
   :enforcement :claim-evaluator}
  {:property :pro-rata/conservation
   :enforcement :claim-evaluator}
  {:property :pro-rata/quota-bounded
   :enforcement :claim-evaluator}]

 :concept/security-significance
