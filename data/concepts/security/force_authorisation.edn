{:concept/id :security/force-authorisation
 :concept/type :security
 :concept/layer :stakeholder
 :concept/name "Force-authorisation"
 :concept/summary
 "Force-authorisation restores liveness when the expected authorising entity
  (such as a resolver) is unavailable, unresponsive, or incapacitated. It
  permits a governance-designated actor to execute a settlement that would
  normally require the resolver's approval, under a strictly bounded scope."

 :concept/stakeholder-question
 "Can a settlement proceed when the resolver is unavailable, and are there
  safeguards to prevent unauthorised or unbounded forced settlement?"

 :concept/protocols #{:protocol/sew-v1 :protocol/prf}

 :concept/vocabulary
 {:force-authorisation/request
  {:description "A request to authorise a forced settlement, specifying the workflow, action, and scope."
   :maps-to [:protocol.entity/force-authorisation-grant]}
  :force-authorisation/policy
  {:description "The governance rules that determine whether a force-authorisation request is permissible."
   :maps-to [:protocol.entity/governance-policy]}
  :force-authorisation/approvers
  {:description "The set of actors whose approval is required for a force-authorisation."
   :maps-to [:protocol.actor/governance]}
  :force-authorisation/threshold
  {:description "The minimum number of approvals or the minimum authority level required."
   :maps-to [:protocol.parameter/threshold]}
  :force-authorisation/scope
  {:description "The exact custody parameters (token, amount, direction, workflow) that the authorisation permits."
   :maps-to [:protocol.entity/authorisation-scope]}
  :force-authorisation/expiry
  {:description "The time window within which the authorisation may be exercised."
   :maps-to [:protocol.entity/expiry-deadline]}
  :force-authorisation/execution
  {:description "The act of executing a settlement under a force-authorisation."
   :maps-to [:protocol.action/execute-force-settlement]}
  :force-authorisation/replay-protection
  {:description "The mechanism preventing the same authorisation from being used more than once."
   :maps-to [:protocol.guard/single-use]}
  :force-authorisation/custody-impact
  {:description "The effect of a forced settlement on the custody ledger."
   :maps-to [:protocol.outcome/custody-adjustment]}
  :force-authorisation/auth-id
  {:description "The shorthand identifier ('force-auth') deterministically derived from the workflow, direction (release/refund), and scope-hash prefix; it binds grant, execution, and consumption records so lifecycle ordering is verifiable."
   :maps-to [:protocol.entity/authorisation-record]}
  :force-authorisation/lifecycle
  {:description "The strictly ordered lifecycle of a grant: grant records a force-authorisation in :active status; execute resolves the workflow while the grant stays :active; finalization consumes the grant via sub-held, moving it to :consumed. Expiry or revocation must precede execution to be valid. Violating the order (consumption without a grant, executed-after-expiry, reuse) is invalid."
   :maps-to [:protocol.outcome/single-use-enforced :protocol.outcome/expiry-enforced]}
  :force-authorisation/lifecycle-summary
  {:description "A reviewer-facing summary of a force-authorisation execution chain with decision, execution, verification, and qualification sections (decision status, approvals/dissents, threshold, terminal consumption status, receipt hash, and provenance references)."
   :maps-to [:protocol.action/report]}}

 :concept/roles
 {:governance-authoriser
  {:description "Entity that grants force-authorisation."
   :maps-to [:protocol.actor/governance]}
  :force-executor
  {:description "Entity that executes the forced settlement."
   :maps-to [:protocol.actor/keeper :protocol.actor/governance]}
  :scope-beneficiary
  {:description "Party that receives the settlement proceeds under the authorised scope."
   :maps-to [:protocol.actor/sender :protocol.actor/recipient]}}

 :concept/entities
 {:force-authorisation-grant
  {:description "A recorded grant that permits a specific settlement within a defined scope."
   :maps-to [:protocol.entity/authorisation-record]}
  :authorisation-scope
  {:description "The immutable scope parameters committed at grant time."
   :maps-to [:protocol.entity/scope-map]}
  :consumption-registry
  {:description "A record of which authorisations have been consumed."
   :maps-to [:protocol.entity/consumption-registry]}}

 :concept/actions
 {:grant-force-authorisation
  {:description "Record a new force-authorisation with a specific scope and expiry."
   :maps-to [:protocol.action/grant-authorisation]}
  :execute-force-authorisation
  {:description "Settle a workflow using a previously granted force-authorisation."
   :maps-to [:protocol.action/execute-authorised-action]}
  :revoke-force-authorisation
  {:description "Cancel a force-authorisation before it is exercised."
   :maps-to [:protocol.action/revoke-authorisation]}
  :verify-force-authorisation-lifecycle
  {:description "Verify lifecycle order and consistency: every consumed auth has a matching grant, grants in the consumption registry report :consumed status, scope-hashes authenticate their stored scopes, and no consumption occurs without a preceding grant."
   :maps-to [:protocol.action/check-invariant]}
  :summarise-force-authorisation-lifecycle
  {:description "Produce a concentrated reviewer-facing summary of a force-authorisation execution chain covering decision, execution, verification, and qualification."
   :maps-to [:protocol.action/report]}}

 :concept/outcomes
 {:scope-enforced
  {:description "The force-authorisation consumed only its exact grant-time scope."
   :maps-to [:protocol.outcome/scope-enforced]}
  :scope-drifted
  {:description "The force-authorisation was used outside its grant-time scope."
   :maps-to [:protocol.outcome/scope-violation]}
  :single-use-enforced
  {:description "The force-authorisation was consumed at most once."
   :maps-to [:protocol.outcome/single-use-enforced]}
  :authorisation-expired
  {:description "The force-authorisation expired before being exercised."
   :maps-to [:protocol.outcome/expiry-enforced]}
  :authorisation-revoked
  {:description "The force-authorisation was revoked before being exercised."
   :maps-to [:protocol.outcome/revoked]}
  :lifecycle-consistent
  {:description "The grant→execute→consume ordering held: every consumption has a matching grant, consumed grants report :consumed status, and stored scope-hashes authenticate their scope maps."
   :maps-to [:protocol.outcome/single-use-enforced :protocol.outcome/scope-enforced]}}

 :concept/failure-modes
 [{:failure/id :scope-mismatch
   :failure/name "Scope mismatch"
   :failure/summary "An executed force-authorisation used a scope different from its grant-time commitment."
   :protocol-mechanisms [:scope-hash :scope-enforcement]
   :stakeholder-impact "Funds may be misdirected or custody boundaries violated."}
  {:failure/id :reuse
   :failure/name "Authorisation reuse"
   :failure/summary "The same force-authorisation grant was used to execute multiple settlements."
   :protocol-mechanisms [:consumption-registry :single-use-guard]
   :stakeholder-impact "Multiple unauthorised settlements drain custody."}
  {:failure/id :pre-execution
   :failure/name "Premature execution"
   :failure/summary "A force-authorisation was executed before its grant was recorded or confirmed."
   :protocol-mechanisms [:evidence-ordering :attestation-chain]
   :stakeholder-impact "Settlement may be inconsistent with governance intent."}
  {:failure/id :expired-execution
   :failure/name "Expired authorisation"
   :failure/summary "A force-authorisation was executed after its expiry deadline."
   :protocol-mechanisms [:expiry-guard]
   :stakeholder-impact "A stale authorisation may not reflect current governance intent."}
  {:failure/id :custody-leak
   :failure/name "Custody leak"
   :failure/summary "A forced settlement consumed custody from a different position than authorised."
   :protocol-mechanisms [:position-isolation :custody-partition]
   :stakeholder-impact "Custody accounting becomes inconsistent between positions."}
  {:failure/id :orphan-consumption
   :failure/name "Orphan consumption"
   :failure/summary "The consumption registry contains an auth-id with no matching grant record — consumption occurred without a preceding grant."
   :protocol-mechanisms [:consumption-registry :lifecycle-consistency]
   :stakeholder-impact "An unbound consumption implies a settlement ran without a valid authorisation grant."}
  {:failure/id :consumed-without-status
   :failure/name "Consumed without status"
   :failure/summary "A grant appears in the consumption registry but its record status is not :consumed, so lifecycle order (consume only after grant) is inconsistent."
   :protocol-mechanisms [:consumption-registry :lifecycle-consistency]
   :stakeholder-impact "Grant and consumption state disagree, undermining replay and forensic verification."}
  {:failure/id :stored-scope-hash-mismatch
   :failure/name "Stored scope-hash mismatch"
   :failure/summary "A grant's stored scope-hash does not authenticate its stored scope map, or a scope-hash exists without a scope map."
   :protocol-mechanisms [:scope-hash :lifecycle-consistency]
   :stakeholder-impact "The grant cannot be trusted to bound the settlement it authorises."}]

 :concept/metrics
 {:force-authorisation-count
  {:description "Number of force-authorisations granted."
   :source :derived-from-trace}
  :force-authorisation-execution-count
  {:description "Number of force-authorisations executed."
   :source :derived-from-trace}
  :force-authorisation-expiry-count
  {:description "Number of force-authorisations that expired before execution."
   :source :derived-from-trace}
  :scope-hash-match?
  {:description "Whether the execution scope-hash matched the grant scope-hash."
   :source :derived-from-evidence}
  :lifecycle-consistent?
  {:description "Whether the force-authorisation lifecycle order held (no orphan consumption, consumed statuses consistent, scope-hashes authenticate scopes)."
   :source :derived-from-invariant-results}
  :consumption-record-count
  {:description "Number of consumption records in the consumption registry."
   :source :derived-from-trace}}

 :concept/assumptions
 ["Force-authorisation is a governance-level override for exceptional circumstances."
  "The governance identity that grants authorisation is correctly configured."
  "Scope integrity depends on content-addressed hashing of the grant-time parameters."
  "The consumption registry is append-only and cannot be rewritten."
  "Evidence ordering (grant before execution) is independently verifiable."
  "Lifecycle is strictly ordered: a grant must precede execution, execution must precede consumption during finalization, and expiry or revocation must precede execution to be valid."]

 :concept/out-of-scope
 ["Safety or correctness of the authorised change."
  "Guarantee of successful execution."
  "Guarantee that execution will produce the intended result."
  "Approval of content outside the committed target."
  "Permission after expiry or consumption."
  "Resolution of unrelated known gaps."]}
