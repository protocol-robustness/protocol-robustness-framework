{:schema-version "notebooks.v1"
 :description    "Declarative metadata registry for all Clerk notebooks.
                  Navigation, status indicators, and the hub index are
                  generated from this file — edit here to update nav."

 ;; ── category taxonomy ───────────────────────────────────────────────────────
 :categories
 {:security-validation {:label "Security Validation"   :icon "🛡️"  :order 1}
  :adversarial         {:label "Adversarial Scenarios" :icon "⚔️"  :order 2}
  :economic-analysis   {:label "Economic Analysis"     :icon "📊"  :order 3}
  :replay-determinism  {:label "Replay & Determinism"  :icon "🔁"  :order 4}
  :evidence-artifacts  {:label "Evidence Artifacts"    :icon "🗂️"  :order 5}
  :findings            {:label "Findings & Issues"     :icon "🔍"  :order 6}
  :governance          {:label "Governance"            :icon "⚖️"  :order 7}
  :yield-liquidity     {:label "Yield & Liquidity"     :icon "💧"  :order 8}
  :provenance          {:label "Provenance & Manifests":icon "📋"  :order 9}
  :demos               {:label "Demos"                 :icon "🎬"  :order 10}
  :tooling             {:label "Tooling & Workbench"   :icon "🔧"  :order 11}
  :experimental        {:label "Experimental"          :icon "🧪"  :order 12}}

 ;; ── threat taxonomy (for Security Concerns quick-nav) ───────────────────────
 :threats
 {:resolver-cartelization {:label "Resolver Cartelization" :severity :high}
  :governance-capture     {:label "Governance Capture"     :severity :high}
  :replay-divergence      {:label "Replay Divergence"      :severity :high}
  :escalation-abuse       {:label "Escalation Abuse"       :severity :medium}
  :economic-extraction    {:label "Economic Extraction"    :severity :high}
  :liquidity-shortfall    {:label "Liquidity Shortfall"    :severity :medium}
  :yield-reorg-race       {:label "Yield Reorg Race"       :severity :medium}
  :griefing               {:label "Griefing"               :severity :low}
  :oracle-failure         {:label "Oracle Failure"         :severity :medium}
  :same-block-ordering    {:label "Same-Block Ordering"    :severity :medium}}

  ;; ── public themes (for the exported screenshot site's Explore layer) ────────
  ;; A newcomer-facing simplification of :categories. Each notebook's
  ;; :presentation.theme picks one; the exporter never hard-codes membership.
  :themes
  {:failures-attacks       {:label "Failures & attacks"       :icon "⚔️"  :blurb "Admission failures, adversarial escalation, short circuits, invariant failures."}
   :allocation-liquidity   {:label "Allocation & liquidity"   :icon "💧"  :blurb "Pro-rata, withdrawals, partial fills, liquidity recovery."}
   :disputes-governance    {:label "Disputes & governance"    :icon "⚖️"  :blurb "Dispute resolution, appeals, governance decisions."}
   :evidence-reproducibility {:label "Evidence & reproducibility" :icon "🔗" :blurb "Evidence graph, reports, provenance, canonical hashing."}
   :simulation-scenarios   {:label "Simulation & scenarios"   :icon "🧪"  :blurb "Workbenches, multi-epoch behaviour, telemetry."}}

  ;; ── notebook registry ────────────────────────────────────────────────────────
  ;; :status values: :verified :partial :experimental :draft :stale :requires-review
  ;; :risk   values: :high :medium :low :informational
  ;; Categories: notebook belongs to ALL listed; first = primary for nav highlighting
  ;; :presentation — editorial layer for the exported site (optional):
  ;;   :theme          one of :themes keys (public Explore section)
  ;;   :kind           :demo | :analysis | :report | :tool
  ;;   :audience-level :intro | :intermediate | :deep-dive
  ;;   :featured?      true → appears on the homepage "Start here" rail
  ;;   :start-here-rank 1..n (ordered, only meaningful when :featured?)
  ;;   :question       newcomer-friendly one-liner ("Why was this rejected?")
  ;;   :deeper-id      larger notebook a demo points to ("See the deeper analysis")
  :notebooks
  [{:id             :report
    :path           "notebooks/report.clj"
   :title          "Evidence Workbook"
   :summary        "At-a-glance evidence surface for a validation run. Status indicators paired with source artifacts and known limitations."
   :categories     [:security-validation :evidence-artifacts]
   :audience       [:reviewer :auditor :researcher]
   :status         :verified
   :risk           :high
   :protocol-areas [:dispute-resolution :invariants :escrow]
   :threats        [:resolver-cartelization :escalation-abuse]
    :tags           ["invariants" "evidence" "findings" "benchmark"]
    :presentation   {:theme :evidence-reproducibility :kind :report
                     :audience-level :intermediate
                     :question "What does one validation run actually surface, and what are its limitations?"}}

  {:id             :protocol-provenance
