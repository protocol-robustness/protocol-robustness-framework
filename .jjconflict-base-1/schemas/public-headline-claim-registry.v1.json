{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Public Headline Claim Registry v1",
  "type": "object",
  "required": ["public-headline-claim-registry/version", "claims"],
  "properties": {
    "public-headline-claim-registry/version": { "const": 1 },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim/id", "claim/version", "publication/status", "claim/text", "claim/scope", "claim/assumptions", "benchmark/claims", "evaluator/id", "evaluator/version", "evaluator/implementation", "policy/canonical-edn", "policy/sha256", "evidence/packages", "publication/copy"],
        "properties": {
          "claim/id": { "type": "string", "pattern": "^PHC-[0-9]{4}$" },
          "claim/version": { "type": "integer", "minimum": 1 },
          "publication/status": { "enum": ["draft", "published", "superseded", "withdrawn"] },
          "claim/text": { "type": "string", "minLength": 1 },
          "claim/scope": { "type": "string", "minLength": 1 },
          "claim/assumptions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "benchmark/claims": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["benchmark/id", "claims"], "properties": { "benchmark/id": { "type": "string" }, "claims": { "type": "array", "minItems": 1, "items": { "type": "string" } } } } },
          "evaluator/id": { "type": "string" },
          "evaluator/version": { "type": "string" },
          "evaluator/implementation": { "type": "object", "required": ["path", "sha256"] },
          "policy/canonical-edn": { "type": "string" },
          "policy/sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "evidence/packages": { "type": "array" },
          "publication/copy": { "type": "object", "required": ["headline", "summary"] }
        }
      }
    }
  }
}
