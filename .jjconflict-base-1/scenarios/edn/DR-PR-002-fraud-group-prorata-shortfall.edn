{:schema-version "1.0"
 :scenario-id "dr-pr-002-fraud-group-prorata-shortfall"
 :scenario-title "Fraud-group pro-rata slash — stake-capacity shortfall"
 :scenario-purpose "Verify a governance-declared fraud-group slash whose obligation exceeds the immutable group's total slashable stake. The allocator records each member's capped pro-rata contribution and the unrecovered shortfall without overdrawing either resolver."
 :scenario-notes "The immutable group snapshot has stakes 100 and 300. A 600 obligation can collect only 400: resolver-a contributes 100, resolver-b contributes 300, and 200 remains unmet. This is a capacity shortfall, not an appeal stay and not a sequential allocation."
 :tags ["suite/dispute-resolution" "coverage/slashing" "coverage/pro-rata" "coverage/shortfall"]
 :threat-tags ["slash" "pro-rata" "shortfall" "custody"]
 :purpose "assurance"
 :initial-block-time 1000
 :protocol-params {:resolver-fee-bps 0
                   :resolver-bond-bps 0
                   :appeal-window-duration 60
                   :slash-epoch-cap-bps 10000
                   :max-dispute-duration 2592000
                   :governance-mode :restricted}
 :agents [{:id "buyer" :address "0xbuyer" :strategy "honest"}
          {:id "seller" :address "0xseller" :strategy "honest"}
          {:id "resolver-a" :address "0xresolver-a" :role "resolver"}
          {:id "resolver-b" :address "0xresolver-b" :role "resolver"}
          {:id "governance" :address "0xgov" :role "governance"}
          {:id "keeper" :address "0xkeeper" :role "keeper"}]
 :events [{:seq 0 :time 1000 :agent "resolver-a" :action "register_stake" :params {:amount 100 :token "USDC"}}
          {:seq 1 :time 1000 :agent "resolver-b" :action "register_stake" :params {:amount 300 :token "USDC"}}
          {:seq 2 :time 1010 :agent "buyer" :action "create_escrow" :params {:token "USDC" :to "0xseller" :amount 1000 :custom-resolver "0xresolver-b"}}
          {:seq 3 :time 1060 :agent "buyer" :action "raise_dispute" :params {:workflow-id 0}}
          {:seq 4 :time 1100 :agent "resolver-b" :action "execute_resolution" :params {:workflow-id 0 :is-release false :resolution-hash "0xgroup-shortfall-resolution"}}
          {:seq 5 :time 1130 :agent "governance" :action "declare_fraud_incident"
           :params {:incident/id "dr-pr-002"
                    :incident/kind :governance-declared-group-fraud
                    :incident/affected-workflows [{:workflow-id 0}]
                    :incident/related-claims []
                    :incident/evidence-refs []
                    :incident/rationale "Governance-declared common fraud event for the disputed workflow."}
           :bind {:fraud-incident-id :incident-id :fraud-incident-hash :incident-hash}}
          {:seq 6 :time 1131 :agent "governance" :action "propose_fraud_group_slash"
           :params {:workflow-id 0 :liable-resolvers ["0xresolver-b" "0xresolver-a"] :amount 600
                    :liability-justification
                    {:kind :governance-declared-group-fraud
                     :incident-ref {:schema-version "fraud-incident-ref.v1"
                                    :incident-id {:from-binding :fraud-incident-id}
                                    :incident-hash {:from-binding :fraud-incident-hash}}}}
           :bind {:group-slash-id :slash-id}}
          {:seq 7 :time 1161 :agent "keeper" :action "execute_pending_settlement" :params {:workflow-id 0}}
          {:seq 8 :time 1200 :agent "keeper" :action "execute_fraud_group_slash"
           :params {:workflow-id 0 :slash-id {:from-binding :group-slash-id}}}]}
