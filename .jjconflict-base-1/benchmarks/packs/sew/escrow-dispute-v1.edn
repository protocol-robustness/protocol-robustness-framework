{:benchmark/id              :benchmark/sew-escrow-dispute-v1
  :benchmark/version         1
  :benchmark/status          :active
  :benchmark/domain          :domain/escrow-dispute-resolution
  :benchmark/protocol        :protocol/sew
   :benchmark/scenario-suite  :suite/sew-dispute-safety-v1
:benchmark/scenario-suite-description
    "65 Sew dispute-resolution scenarios covering basic release/refund,
     evidence lifecycle, resolver incentives, escalation paths, capacity
     exhaustion, and governance interactions, plus the resolver
     response-window scenarios S-DR-100/101/102."
   :benchmark/runner-policy   :runner-policy/deterministic-local-v1
  :benchmark/evidence-policy :evidence-policy/forensic-standard-v1
    :benchmark/scoring-rule    :scoring/severity-weighted-robustness-v1
    :benchmark/property-types  #{:safety :liveness}
    :benchmark/property-claims {:safety [:claim/no-unauthorized-release
                                         :claim/funds-conserved
                                         :claim/slashing-conservation
                                         :claim/governance-non-interference
                                         :claim/solvency-status]
                                :liveness [:claim/dispute-liveness
                                           :claim/resolver-response-deadline]}
:benchmark/description
    "A lens over :suite/sew-dispute-safety-v1 focusing on end-to-end
     dispute safety: unauthorized release prevention, fund conservation,
     dispute liveness, slashing integrity, and governance non-interference.
     Shares the same 65-scenario suite with dispute-liveness-v1 and
     resolver-slashing-v1 — a single suite run provides evidence for all
     three benchmarks, but each applies a different scoring rule and
     different claim weights."
   :benchmark/purpose
   "Evaluate Sew escrow dispute resolution across unauthorized release
    prevention, fund conservation, dispute liveness, slashing integrity,
    and governance non-interference."
  :benchmark/concepts        [:decision-quality/solvency-status
                              :attestation/verification
                              :consensus/authority
                              :consensus/evidence
                              :consensus/finality
                              :consensus/escalation
                              :consensus/liveness
                              :consensus/legitimacy
                              :concept/conservation
                              :concept/confidence
                              :concept/configuration]
  :benchmark/claims          [{:claim/id :claim/no-unauthorized-release
                              :claim/role :primary
                              :claim/rationale "Escrow funds must only move through authorized settlement paths."
                              :claim/failure-meaning "Funds were released without proper authorization."}
                             {:claim/id :claim/funds-conserved
                              :claim/role :primary
                              :claim/rationale "Total escrow value must be conserved across state transitions."
                              :claim/failure-meaning "Escrow value changed outside authorized settlement."}
                             {:claim/id :claim/dispute-liveness
                              :claim/role :supporting
                              :claim/rationale "Disputes must resolve in bounded time under adversarial load."
                              :claim/failure-meaning "Dispute resolution stalled or exceeded time bounds."}
                             {:claim/id :claim/slashing-conservation
                              :claim/role :supporting
                              :claim/rationale "Slashing must distribute amounts consistently and conserve value."
                              :claim/failure-meaning "Slashed amounts violated conservation or distribution rules."}
                              {:claim/id :claim/governance-non-interference
                               :claim/role :supporting
                               :claim/rationale "Governance actions must not interfere with active escrow state."
                               :claim/failure-meaning "Governance interfered with an active escrow."}
                              {:claim/id :claim/solvency-status
                               :claim/role :supporting
                               :claim/rationale "Escrow solvency is maintained across all dispute resolution transitions."
                               :claim/failure-meaning "Solvency invariant failed — escrow total-held did not equal liabilities."}
                              {:claim/id :claim/resolver-response-deadline
                               :claim/role :supporting
                               :claim/rationale "A stalling resolver must not hold a dispute hostage: once :resolver-response-window expires, a fresh resolver can resolve (no premature escalation before the window)."
                               :claim/failure-meaning "A fresh resolver resolved before the response window expired (premature escalation), or the dispute remained hostage to a stalling resolver."}]}
