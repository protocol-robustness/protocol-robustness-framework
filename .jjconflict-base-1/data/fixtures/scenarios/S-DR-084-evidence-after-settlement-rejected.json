{
   "scenario-id" : "s-dr-084-evidence-after-settlement-rejected",
   "schema-version" : "1.0",
   "initial-block-time" : 1000,
   "scenario-title" : "Evidence after settlement rejected — submit_evidence after escrow finalized",
   "scenario-purpose" : "Verify that calling submit_evidence on a finalized (released/refunded) escrow fails with :transfer-not-in-dispute. Evidence may only be submitted while a dispute is active.",
   "purpose" : "adversarial-robustness",
   "threat-tags" : ["dispute-resolution", "evidence", "finality"],
   "tags" : ["suite/dispute-resolution", "coverage/evidence"],
   "strict-expected-errors?": true,
   "expected-errors" : [ {
      "seq" : 4, "action" : "submit_evidence", "error" : "transfer-not-in-dispute"
    } ],
   "expectations": {
     "terminal": [ {
       "path": [ "live-states", 0 ],
       "equals": "released"
     } ],
     "step-terminal": [ {
       "seq": 3,
       "path": [ "live-states", 0 ],
       "equals": "released"
     } ]
   },
   "agents" : [ {
     "id" : "buyer", "address" : "0xbuyer", "strategy" : "honest"
   }, {
     "id" : "seller", "address" : "0xseller", "strategy" : "honest"
   }, {
     "id" : "resolver", "address" : "0xresolver", "role" : "resolver"
   }, {
     "id" : "keeper", "address" : "0xkeeper", "role" : "keeper"
   } ],
   "protocol-params" : {
     "resolver-fee-bps" : 150,
   "appeal-window-duration" : 60,
     "max-dispute-duration" : 2592000,
     "resolver-bond-bps": 0
   },
  "events": [
    {
      "seq": 0,
      "time": 1000,
      "agent": "buyer",
      "action": "create_escrow",
      "params": {
        "token": "USDC",
        "to": "0xseller",
        "amount": 5000,
        "custom-resolver": "0xresolver"
      }
    },
    {
      "seq": 1,
      "time": 1060,
      "agent": "buyer",
      "action": "raise_dispute",
      "params": {
        "workflow-id": 0
      }
    },
    {
      "seq": 2,
      "time": 1120,
      "agent": "resolver",
      "action": "execute_resolution",
      "params": {
        "workflow-id": 0,
        "is-release": true,
        "resolution-hash": "0xhash"
      }
    },
    {
      "seq": 3,
      "time": 1250,
      "agent": "keeper",
      "action": "execute_pending_settlement",
      "params": {
        "workflow-id": 0
      }
    },
    {
      "seq": 4,
      "time": 1320,
      "agent": "seller",
      "action": "submit_evidence",
      "params": {
        "workflow-id": 0,
        "evidence-hash": "0xtoo-late"
      }
    }
  ],
  "scenario-author": "@kilo-research",
  "provenance": {
    "author-id": "@kilo-research",
    "author": "Kilo Research"
  }
}