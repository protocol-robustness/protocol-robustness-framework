  ;; State representation and guarded escrow transitions form a small Sew
  ;; kernel. The full reference protocol composes this with optional systems.
  :prf/sew-escrow-kernel-v1
  {:component/plane :protocol-kernel
   :component/requires [:prf/framework-v1]
   :component/owned-namespaces
   [resolver-sim.protocols.sew.kernel
    resolver-sim.protocols.sew.types
    resolver-sim.protocols.sew.state-machine]
   :component/entry-namespaces
   [resolver-sim.protocols.sew.kernel]
   :component/material
   [{:path "protocols_src/test/resolver_sim/protocols/sew/kernel_test.clj"
     :kind :test-source}]}

