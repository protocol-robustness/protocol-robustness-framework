     :kind :test-source}]}

  ;; Runnable/application assembly is deliberately separate from the portable
  ;; framework base. It may compose protocol and semantic implementations.
  :prf/runner-v1
  {:component/plane :runner
   ;; The runnable simulation CLI assembles Sew phases and research adapters.
   ;; Keep that dependency explicit so framework-only consumers can select the
   ;; portable framework without treating the application runner as core.
   :component/requires [:prf/framework-v1
                        :prf/sew-protocol-model-v1
                        :prf/sew-analysis-v1
                        :prf/sew-pro-rata-slashing-v1]
   :component/owned-namespaces
   [resolver-sim.core.phases
    resolver-sim.definitions.runner-execution-registry
    resolver-sim.protocols.sew.runner-extension
    resolver-sim.protocols.sew.runner-replay
    resolver-sim.protocols.sew.io.trace-export
    resolver-sim.protocols.sew.research-models.ring-batch
    resolver-sim.protocols.sew.dispute-context.case-bundle
    resolver-sim.protocols.sew.dispute-context.disagree
    resolver-sim.commands.protocol-finality
    resolver-sim.commands.invariants-run
    resolver-sim.sim.fixtures
    resolver-sim.sim.reference-validation
    resolver-sim.sim.reference-validation-evidence
    resolver-sim.io.scenario-runner
    resolver-sim.server.grpc
    resolver-sim.io.diff-runner]
   :component/entry-namespaces
   [resolver-sim.core.phases
    resolver-sim.definitions.runner-execution-registry
    resolver-sim.protocols.sew.runner-extension
    resolver-sim.protocols.sew.runner-replay
    resolver-sim.protocols.sew.io.trace-export
    resolver-sim.protocols.sew.research-models.ring-batch
    resolver-sim.protocols.sew.dispute-context.case-bundle
    resolver-sim.protocols.sew.dispute-context.disagree
    resolver-sim.commands.protocol-finality
    resolver-sim.commands.invariants-run
    resolver-sim.sim.fixtures
    resolver-sim.sim.reference-validation
    resolver-sim.sim.reference-validation-evidence
    resolver-sim.io.scenario-runner
    resolver-sim.server.grpc
    resolver-sim.io.diff-runner]
   :component/material
   [{:path "test/resolver_sim/sim/fixtures_mc_batch_test.clj"
     :kind :test-source}
    {:path "test/resolver_sim/sim/reference_validation_evidence_test.clj"
     :kind :test-source}
    {:path "protocols_src/test/resolver_sim/protocols/sew/research_models/ring_batch_test.clj"
     :kind :test-source}
    {:path "protocols_src/test/resolver_sim/protocols/sew/replay_test.clj"
     :kind :test-source}
