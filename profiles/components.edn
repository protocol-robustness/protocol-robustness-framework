{:components
 {:prf/framework-v1
  {:component/plane :framework
   :component/owned-namespaces
   [resolver-sim.hash.canonical
    resolver-sim.hash.reference
    resolver-sim.evidence.node
    resolver-sim.config.defaults
    resolver-sim.execution.budget
    resolver-sim.logging
    resolver-sim.time.context
    resolver-sim.time.deadlines]
   :component/entry-namespaces
   [resolver-sim.hash.canonical
    resolver-sim.hash.reference
    resolver-sim.evidence.node
    resolver-sim.config.defaults
    resolver-sim.execution.budget
