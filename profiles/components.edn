     :kind :test-source}
    {:path "test/resolver_sim/contract_model/replay_batch_sew_test.clj"
     :kind :test-source}
    {:path "protocols_src/test/resolver_sim/commands/invariants_run_test.clj"
     :kind :test-source}
    {:path "test/resolver_sim/contract_model/replay/analysis_test.clj"
     :kind :test-source}
    {:path "protocols_src/test/resolver_sim/protocols/sew/dispute_context/case_bundle_test.clj"
     :kind :test-source}
    {:path "protocols_src/test/resolver_sim/protocols/sew/dispute_context/disagree_test.clj"
     :kind :test-source}
    {:path "data/fixtures/protocol"
     :kind :runtime-fixtures}]}

  :prf/sew-protocol-model-v1
  {:component/plane :protocol
   :component/requires [:prf/framework-v1
                        :prf/sew-escrow-kernel-v1
                        :prf/yield-runtime-v1
                        :prf/sew-pro-rata-economics-v1]
   :component/owned-namespaces
   [resolver-sim.protocols.sew
    resolver-sim.protocols.sew.yield-extension
    resolver-sim.protocols.sew.yield.policy
    resolver-sim.protocols.sew.yield.invariants
    resolver-sim.protocols.sew.slash-evidence
    resolver-sim.protocols.sew.appeal-bond-projection
    resolver-sim.protocols.sew.replay.appeal-bond
    resolver-sim.cancellation.sew-projection]
   :component/entry-namespaces
   [resolver-sim.protocols.sew
    resolver-sim.protocols.sew.yield-extension
    resolver-sim.protocols.sew.appeal-bond-projection
    resolver-sim.cancellation.sew-projection
    resolver-sim.protocols.sew.replay.appeal-bond]
   :component/material
   [{:path "protocols_src/test/resolver_sim/cancellation/projection_conformance_test.clj"
     :kind :test-source}
    {:path "protocols_src/test/resolver_sim/protocols/sew/replay/appeal_bond_test.clj"
     :kind :test-source}
