    resolver-sim.yield.transition-basis]
   :component/entry-namespaces
   [resolver-sim.yield.accounting
    resolver-sim.yield.accrual
    resolver-sim.yield.commitment-projection
    resolver-sim.yield.evidence
    resolver-sim.yield.exact-math
    resolver-sim.yield.expectations
    resolver-sim.yield.invariants
