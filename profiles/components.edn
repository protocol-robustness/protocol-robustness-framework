     :kind :test-source}
    {:path "protocols_src/test/resolver_sim/protocols/sew/extension_test.clj"
     :kind :test-source}]}

  ;; Operation-limited behavior candidate aligned to the Solidity Sew Core
  ;; deployment profile. This adapts the in-tree model and therefore still
  ;; carries the full model's dependency closure; it is not a standalone
  ;; package boundary.
  :prf/sew-core-extension-v1
  {:component/plane :protocol-extension
   :component/requires [:prf/sew-protocol-model-v1]
   :component/owned-namespaces
   [prf.extensions.sew-core-model.adapter]
   :component/entry-namespaces
   [prf.extensions.sew-core-model.adapter]
   :component/material
   [{:path "extensions/sew-core-model/deps.edn"
     :kind :package-manifest}
    {:path "packages/sew-protocol-model/deps.edn"
     :kind :package-manifest}
    {:path "extensions/sew-core-model/test/prf/extensions/sew_core_model/adapter_test.clj"
     :kind :test-source}
    {:path "extensions/sew-core-model/test/prf/extensions/sew_core_model/solidity_vectors.edn"
     :kind :conformance-fixture}]}

  ;; Consensus force-authorisation verification is an optional protocol
  ;; integration. The Sew adapter delegates researcher artifact validation to
  ;; the shared benchmark and governed-authority APIs.
  :prf/sew-force-authorisation-v1
  {:component/plane :protocol-extension
   :component/requires [:prf/framework-v1]
   :component/owned-namespaces
   [resolver-sim.protocols.sew.force-authorisation
    resolver-sim.protocols.sew.force-authorisation-extension]
   :component/entry-namespaces
   [resolver-sim.protocols.sew.force-authorisation-extension]
   :component/material
   [{:path "protocols_src/test/resolver_sim/protocols/sew/force_authorisation_test.clj"
     :kind :test-source}]}

  ;; Trace projections and game-theoretic validators are optional Sew analysis
  ;; integrations. The protocol model keeps stable fallback behavior when this
  ;; component is not selected.
  :prf/sew-analysis-v1
  {:component/plane :protocol-extension
   :component/requires [:prf/sew-protocol-model-v1]
   :component/owned-namespaces
   [resolver-sim.protocols.sew.analysis-extension
    resolver-sim.protocols.sew.advisory
    resolver-sim.protocols.sew.equilibrium
    resolver-sim.protocols.sew.projection
    resolver-sim.protocols.sew.validator-registry]
   :component/entry-namespaces
   [resolver-sim.protocols.sew.analysis-extension]
   :component/material
   [{:path "protocols_src/test/resolver_sim/protocols/sew/accounting_projection_test.clj"
     :kind :test-source}
    {:path "protocols_src/test/resolver_sim/protocols/sew/funds_ledger_projection_test.clj"
     :kind :test-source}
    {:path "test/resolver_sim/protocols/sew/validator_registry_test.clj"
     :kind :test-source}
    {:path "protocols_src/test/resolver_sim/protocols/sew/extension_test.clj"
     :kind :test-source}
    {:path "test/resolver_sim/scenario/equilibrium_test.clj"
     :kind :test-source}]}

