{:components
 {:prf/framework-v1
  {:component/plane :framework
   :component/owned-namespaces
   [resolver-sim.hash.canonical
    resolver-sim.hash.reference
    resolver-sim.evidence.node
    resolver-sim.config.defaults
    resolver-sim.execution.budget
    resolver-sim.logging
    resolver-sim.time.context
    resolver-sim.time.deadlines]
   :component/entry-namespaces
   [resolver-sim.hash.canonical
    resolver-sim.hash.reference
    resolver-sim.evidence.node
    resolver-sim.config.defaults
    resolver-sim.execution.budget
    resolver-sim.logging
    resolver-sim.time.context
    resolver-sim.time.deadlines]
   :component/material
   [{:path "config" :kind :runtime-configuration}]}

  ;; Runnable/application assembly is deliberately separate from the portable
  ;; framework base. It may compose protocol and semantic implementations.
  :prf/runner-v1
  {:component/plane :runner
   :component/requires [:prf/framework-v1]
   :component/owned-namespaces
   [resolver-sim.core.phases
    resolver-sim.io.scenario-runner
    resolver-sim.server.grpc
    resolver-sim.io.diff-runner]
   :component/entry-namespaces
   [resolver-sim.core.phases
    resolver-sim.io.scenario-runner
    resolver-sim.server.grpc
    resolver-sim.io.diff-runner]}

  :prf/sew-core-v1
  {:component/plane :protocol
   :component/requires [:prf/framework-v1
                        :prf/sew-escrow-kernel-v1
                        :prf/sew-pro-rata-slashing-v1]
   :component/owned-namespaces
   [resolver-sim.protocols.sew]
   :component/entry-namespaces
   [resolver-sim.protocols.sew]}

  ;; State representation and guarded escrow transitions form a small Sew
  ;; kernel. The full reference protocol composes this with optional systems.
  :prf/sew-escrow-kernel-v1
  {:component/plane :protocol-kernel
   :component/requires [:prf/framework-v1]
   :component/owned-namespaces
   [resolver-sim.protocols.sew.kernel
    resolver-sim.protocols.sew.types
    resolver-sim.protocols.sew.state-machine]
   :component/entry-namespaces
   [resolver-sim.protocols.sew.kernel]
   :component/material
   [{:path "protocols_src/test/resolver_sim/protocols/sew/kernel_test.clj"
     :kind :test-source}]}

  :prf/ideal-pro-rata-v1
  {:component/plane :semantic
   :component/requires [:prf/framework-v1]
   :component/owned-namespaces
   [resolver-sim.pro-rata.allocation
    resolver-sim.pro-rata.evidence]
   :component/entry-namespaces
   [resolver-sim.pro-rata.allocation
    resolver-sim.pro-rata.evidence]
   :component/material
   [{:path "resources/test-vectors/pro-rata" :kind :conformance-vector}
    {:path "test/fixtures/pro-rata" :kind :test-fixture}
    {:path "test/resolver_sim/pro_rata/allocation_test.clj" :kind :test-source}]}

  :prf/pro-rata-evaluation-v1
  {:component/plane :assurance
   :component/requires [:prf/ideal-pro-rata-v1 :prf/pro-rata-verifier-v1]
   :component/owned-namespaces
   [resolver-sim.pro-rata.evaluation]
   :component/entry-namespaces
   [resolver-sim.pro-rata.evaluation]
   :component/material
   [{:path "test/resolver_sim/pro_rata/programme_test.clj" :kind :test-source}]}

  ;; Sew slash allocation is an explicit adapter over portable allocation and
  ;; evaluated evidence. It contains no dependency on the Sew root namespace.
  :prf/sew-pro-rata-slashing-v1
  {:component/plane :protocol-adapter
   :component/requires [:prf/pro-rata-evaluation-v1]
   :component/owned-namespaces
   [resolver-sim.protocols.sew.pro-rata.economics
    resolver-sim.protocols.sew.pro-rata.evidence]
   :component/entry-namespaces
   [resolver-sim.protocols.sew.pro-rata.economics
    resolver-sim.protocols.sew.pro-rata.evidence]
   :component/material
   [{:path "protocols_src/test/resolver_sim/protocols/sew/evidence/slashing_test.clj"
     :kind :test-source}
    {:path "protocols_src/test/resolver_sim/protocols/sew/slashing_test.clj"
     :kind :test-source}
    {:path "test/resolver_sim/yield/pro_rata_claims_test.clj"
     :kind :test-source}
    {:path "protocols_src/resolver_sim/protocols/sew/test_vectors/slash_allocation.clj"
     :kind :conformance-vector}]}

  :prf/sew-pro-rata-application-v1
  {:component/plane :protocol-adapter
   :component/requires [:prf/ideal-pro-rata-v1 :prf/sew-core-v1]
   :component/owned-namespaces
   [resolver-sim.protocols.sew.pro-rata-application]
   :component/entry-namespaces
   [resolver-sim.protocols.sew.pro-rata-application]}

  :prf/bounty-v1
  {:component/plane :semantic
   :component/absence-enforced? true
   :component/requires [:prf/ideal-pro-rata-v1]
   :component/owned-namespaces
   [resolver-sim.economics.with-bounty.composition
    resolver-sim.protocols.sew.with-bounty]
   :component/entry-namespaces
   [resolver-sim.economics.with-bounty.composition
    resolver-sim.protocols.sew.with-bounty]
   :component/material
   [{:path "test/resolver_sim/economics/with_bounty" :kind :test-source}
    {:path "protocols_src/test/resolver_sim/protocols/sew/with_bounty_test.clj"
     :kind :test-source}]}

  :prf/pro-rata-verifier-v1
  {:component/plane :assurance
   :component/requires [:prf/ideal-pro-rata-v1]
   :component/owned-namespaces
   [resolver-sim.pro-rata.exact-verifier]
   :component/entry-namespaces
   [resolver-sim.pro-rata.exact-verifier]
   :component/material
   [{:path "coprocessor/core" :kind :rust-crate}
    {:path "test/resolver_sim/pro_rata/exact_verifier_test.clj"
     :kind :test-source}]}}

 ;; Claimant options is an implemented runtime capability, but not a source or
 ;; package component. Its profile selects the existing execution abstraction
 ;; and concrete runtime settings without adding material to the source view.
 :runtime-capabilities
 {:prf/claimant-options-v1
  {:runtime/type :prf/claimant-options-v1
   :runtime/status :supported
   :runtime/implementation 'resolver-sim.execution.context/with-claimant-options
   :runtime/options-keys
   [:execution/claimant-parallelism
    :execution/claimant-parallel-threshold
    :execution/quiescence-timeout-seconds]
   :runtime/source-component? false
   :runtime/reason :existing-runtime-abstraction}}}
