;; In-tree source candidate for the PRF Sew protocol model. Framework is pinned
;; to an immutable source revision; the unpublished economics extension still
;; resolves from this checkout until its package manifest reaches a shared Git
;; revision.
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.protocol-robustness/prf-core
        {:git/url "https://github.com/protocol-robustness/protocol-robustness-framework.git"
         :git/sha "b94b091cfbaf46ec34ae2ade4920f9a3751e3097"
         :deps/root "."}
        org.protocol-robustness/prf-sew-pro-rata-economics
        {:local/root "../../extensions/sew-pro-rata-economics"}}
 :aliases {:test {:extra-paths ["test" "../../extensions/sew-yield-integration/src"]
                  :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}}}}}
