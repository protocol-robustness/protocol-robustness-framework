  {:namespace resolver-sim.evidence.chain :owner :prf-canonical :kind :public-contract
   :required? true :blocker :canonical-evidence-contract-unpublished}
  {:namespace resolver-sim.evidence.config :owner :prf-canonical :kind :internal-implementation
   :required? true :blocker :canonical-evidence-contract-unpublished}
  {:namespace resolver-sim.evidence.forensic-graph :owner :prf-canonical :kind :public-contract
