server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root {{ prf_project_dir }}/site/out;
    index index.html;

    # Static site — SPA fallback for Next.js static export
    location / {
        try_files $uri $uri/index.html $uri.html =404;
        expires 1h;
        add_header Cache-Control "public, immutable";
    }

    # Lab API proxy
    location /api/lab/ {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-PRF-Origin-Token {{ lab_origin_token }};
        proxy_read_timeout 90s;
        proxy_connect_timeout 5s;
    }

    # Health check (no auth, lightweight)
    location /api/lab/health {
        proxy_pass http://127.0.0.1:8082;
        proxy_set_header Host $host;
    }

    # Deny access to sensitive paths
    location ~ /(\.git|\.env| secrets) {
        deny all;
        return 404;
    }

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/rss+xml text/javascript;
    gzip_min_length 1000;
}
