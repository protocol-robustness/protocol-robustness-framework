{:schema/version :prf.protocol-boundaries/v3

 ;; ── architecture zones ────────────────────────────────────────────────────
 ;; Each zone owns explicit source roots and namespace prefixes. Dependencies
 ;; between zones follow :architecture/dependency-rules. Exact per-file
 ;; approvals (:approved/extension-dependencies) remain the exception
 ;; mechanism, never the main way extensions are wired.
 :architecture/zones
 [{:zone/id :core
   :source-roots ["src"]
   :namespace-prefixes ["resolver-sim"]}

  {:zone/id :protocol-sew
   :source-roots ["protocols_src"]
   :namespace-prefixes ["resolver-sim.protocols.sew"]}

  {:zone/id :extension-held-custody
   :source-roots ["extensions/held-custody/src"]
   :namespace-prefixes ["prf.extensions.held-custody"]}

  {:zone/id :extension-force-authorisation
   :source-roots ["extensions/force-authorisation/src"]
   :namespace-prefixes ["prf.extensions.force-authorisation"]}]

 ;; Cross-zone dependency graph (same-zone dependencies are implicitly
 ;; permitted; :may-depend-on describes cross-zone dependencies only):
 ;;   protocol-sew → extension-held-custody → core
 ;;   protocol-sew → extension-force-authorisation → core
 ;;   protocol-sew → core
 ;; Capability requirements, rather than Clojure imports, express the
 ;; force-authorisation/held-custody execution relationship. This prevents a
 ;; package-level dependency cycle and keeps extensions independent of Sew.
 ;; Forbidden: core → extension, extension → protocol-sew.
 :architecture/dependency-rules
 [{:from :core
   :may-depend-on #{}}

  {:from :extension-held-custody
   :may-depend-on #{:core}}

  {:from :extension-force-authorisation
   :may-depend-on #{:core}}

  {:from :protocol-sew
   :may-depend-on #{:core :extension-held-custody :extension-force-authorisation}}]

 ;; ── exact per-file approvals (exception mechanism) ────────────────────────
 ;; Every exception is an existing, reviewed framework-to-Sew bridge. Entries
 ;; are exact fully-qualified namespaces or vars, never a file- or prefix-wide
 ;; waiver; see docs/architecture/PROTOCOL_EXTENSION_BOUNDARIES.md.
 :approved/extension-dependencies
 [{:file "src/resolver_sim/protocols/registry.clj"
   :dependency "resolver-sim.protocols.sew/protocol"
   :kind :adapter-registry
   :reason "The registry holds an unloaded adapter symbol and performs the documented optional-extension bootstrap."}
  {:file "src/resolver_sim/sim/batch.clj"
   :dependency "resolver-sim.protocols.sew.research-models.resolver-ring"
   :kind :legacy-static-bridge
   :reason "Existing Sew research-model integration; source relocation is outside WP7 configuration/test scope."}
  {:file "src/resolver_sim/sim/fixtures.clj"
   :dependency "resolver-sim.protocols.sew.invariant-scenarios"
   :kind :legacy-static-bridge
   :reason "Existing Sew fixture integration; source relocation is outside WP7 configuration/test scope."}
  {:file "src/resolver_sim/sim/reference_validation.clj"
   :dependency "resolver-sim.protocols.sew/replay-with-sew-protocol"
   :kind :legacy-dynamic-bridge
   :reason "Sew reference-validation adapter entrypoint."}
  {:file "src/resolver_sim/sim/reference_validation.clj"
   :dependency "resolver-sim.protocols.sew.io.trace-export/export-trace-fixture"
   :kind :legacy-dynamic-bridge
   :reason "Sew trace-fixture export entrypoint."}
  {:file "src/resolver_sim/sim/reference_validation.clj"
   :dependency "resolver-sim.protocols.sew.io.trace-export/write-fixture-file"
   :kind :legacy-dynamic-bridge
   :reason "Sew trace-fixture writer entrypoint."}
  {:file "src/resolver_sim/sim/reference_validation_evidence.clj"
   :dependency "resolver-sim.protocols.sew.invariants/world-invariant-ids"
   :kind :legacy-dynamic-bridge
   :reason "Sew invariant evidence projection."}
  {:file "src/resolver_sim/sim/reference_validation_evidence.clj"
   :dependency "resolver-sim.protocols.sew.invariants/check-all"
   :kind :legacy-dynamic-bridge
   :reason "Sew invariant evidence evaluation."}
  {:file "src/resolver_sim/benchmark/runner.clj"
   :dependency "resolver-sim.protocols.sew.invariants/canonical-ids"
   :kind :adapter-bridge
   :reason "Protocol-native post-replay invariant bridge pending a registry capability."}
  {:file "src/resolver_sim/benchmark/runner.clj"
   :dependency "resolver-sim.protocols.sew.invariants/check-all"
   :kind :adapter-bridge
   :reason "Protocol-native post-replay invariant bridge pending a registry capability."}
  {:file "src/resolver_sim/benchmark/runner.clj"
   :dependency "resolver-sim.protocols.sew/replay-with-sew-protocol"
   :kind :adapter-bridge
   :reason "Sew replay bridge pending a SimulationAdapter-only replay path."}
  {:file "src/resolver_sim/validation/scenario_registry.clj"
   :dependency "resolver-sim.protocols.sew.invariant-scenarios/validate-all-scenarios!"
   :kind :legacy-dynamic-bridge
   :reason "Sew scenario-registry validation."}
  {:file "src/resolver_sim/validation/scenario_registry.clj"
   :dependency "resolver-sim.protocols.sew.invariant-scenarios/scenario-type-registry"
   :kind :legacy-dynamic-bridge
   :reason "Sew scenario-registry metadata."}
  {:file "src/resolver_sim/commands/scenario_extraction.clj"
   :dependency "resolver-sim.protocols.sew.claimable-classification/build-document"
   :kind :legacy-dynamic-bridge
   :reason "Sew claimable-classification command implementation."}
  {:file "src/resolver_sim/commands/invariants_run.clj"
   :dependency "resolver-sim.protocols.sew.invariant-scenarios/all-scenarios"
   :kind :legacy-dynamic-bridge
   :reason "Sew invariant-run command scenario enumeration."}
  {:file "src/resolver_sim/commands/witness_build.clj"
   :dependency "resolver-sim.protocols.sew.procedure-evidence/sew-evidence-adapter"
   :kind :legacy-symbol-bridge
   :reason "Sew procedure-evidence adapter symbol selected by protocol ID."}
  {:file "src/resolver_sim/execution/child.clj"
   :dependency "resolver-sim.protocols.sew.invariants/check-all"
   :kind :legacy-dynamic-bridge
   :reason "Sew child-execution invariant evaluation."}
  {:file "src/resolver_sim/time/invariants.clj"
   :dependency "resolver-sim.protocols.sew.types/terminal-states"
   :kind :legacy-dynamic-bridge
   :reason "Sew terminal-state compatibility lookup."}
  {:file "src/resolver_sim/io/scenario_runner.clj"
   :dependency "resolver-sim.protocols.sew/replay-with-sew-protocol"
   :kind :legacy-dynamic-bridge
   :reason "Sew scenario replay compatibility entrypoint."}
  {:file "src/resolver_sim/io/scenario_runner.clj"
   :dependency "resolver-sim.protocols.sew.narrative/scenario-outline"
   :kind :legacy-dynamic-bridge
   :reason "Sew scenario narrative compatibility entrypoint."}
  {:file "src/resolver_sim/io/scenario_runner.clj"
   :dependency "resolver-sim.protocols.sew.invariant-scenarios/all-scenarios"
   :kind :legacy-dynamic-bridge
   :reason "Sew scenario enumeration compatibility entrypoint."}
  {:file "src/resolver_sim/io/scenario_runner.clj"
   :dependency "resolver-sim.protocols.sew.invariant-scenarios/scenario-type-registry"
   :kind :legacy-dynamic-bridge
   :reason "Sew scenario metadata compatibility entrypoint."}
  {:file "src/resolver_sim/io/claimable_classification_emitter.clj"
   :dependency "resolver-sim.protocols.sew.claimable-classification"
   :kind :legacy-dynamic-bridge
   :reason "Sew claimable-classification namespace is constructed for an optional command."}]

  ;; ── core domain vocabulary approvals (parsed-form, policy-driven) ─────────
  ;; Relevant vocabulary is force-auth held-custody ARTIFACT identifiers
  ;; (artifact kinds, schema/verifier strings) matching
  ;; ^force-auth-(add-held|held-custody). The frozen legacy implementation was
  ;; removed in Phase 3B; the remaining :protocol-neutral approvals are the
  ;; MINIMAL historical-recognition vocabulary that core must keep so it can
  ;; classify/verify the extension-owned historical read contract (sensitivity
  ;; sentinel, canonical reconciliation, and the neutral artifact hashing
  ;; layer the extension's legacy validators call into). Semantic ownership of
  ;; held-custody vocabulary lives in the extension manifest
  ;; (:extension/historical-read), cross-checked by a conformance test; this
  ;; file is NOT the semantic source of truth.
  :approved/core-domain-literals
  [{:file "src/resolver_sim/assurance/canonical_force_authorisation.clj"
    :literals #{"force-auth-add-held"
                "force-auth-add-held-summary"}
    :reason "Protocol-independent reconciliation classifies historical held-custody artifact schema prefixes; extension-owned historical read, cross-checked by conformance test"
    :status :protocol-neutral}
   {:file "src/resolver_sim/sensitivity/sentinel.clj"
    :literals #{:force-auth-add-held
                :force-auth-add-held-summary}
    :reason "Sensitivity sentinel classifies historical force-auth add-held evidence kinds as remote-authority-required; extension-owned historical read, cross-checked by conformance test"
    :status :protocol-neutral}
   {:file "src/resolver_sim/evidence/artifact.clj"
    :literals #{"force-auth-add-held.v1"
                "force-auth-add-held-summary.v1"}
    :reason "Neutral artifact namespace allows the frozen legacy schema versions under the decoded-agreement preimage policy; required by the extension's historical validators, not production vocabulary"
    :status :protocol-neutral}]

  ;; ── core operation vocabulary approvals ────────────────────────────────────
  ;; Exact held-custody operation literals (:add-held / :sub-held /
  ;; :finalize-released / :refund-held and their string spellings). All
  ;; remaining approvals are :protocol-neutral: core emits or classifies the
  ;; operation vocabulary that the held-custody extension contract also owns.
  :approved/core-operation-literals
  [{:file "src/resolver_sim/economics/effects.clj"
    :literals #{"add-held" "sub-held" "finalize-released" "refund-held"}
    :reason "Canonical held-action vocabulary (held-action->direction) and the direction-bound custody-held-adjustment projections; matches the held-custody mutation action names by spelling, not force-auth-add-held artifact vocabulary"
    :status :protocol-neutral}
   {:file "src/resolver_sim/economics/with_bounty/evaluation.clj"
    :literals #{"add-held"}
    :reason "with-bounty custody reservation effect emits the canonical add-held action (v2 contract)"
    :status :protocol-neutral}
   {:file "src/resolver_sim/sensitivity/sentinel.clj"
    :literals #{:add-held "add-held"}
    :reason "Sensitivity sentinel treats a held add-held action as remote-authority-required (forbidden from local in-process authorization); applies to the current held-custody mutation contract"
    :status :protocol-neutral}]

  ;; ── core status vocabulary approvals ───────────────────────────────────────
  ;; Status vocabulary (name-matched, like the artifact family): the exact
  ;; status terms in :architecture/status-vocabulary that appear in core
  ;; source. Remaining approvals are :protocol-neutral (domain-neutral statuses
  ;; and the held add-held action classification).
  :approved/core-status-literals
  [{:file "src/resolver_sim/sensitivity/sentinel.clj"
    :literals #{:add-held "add-held"}
    :reason "Sensitivity sentinel classifies the held add-held action as remote-authority-required"
    :status :protocol-neutral}
   {:file "src/resolver_sim/economics/effects.clj"
    :literals #{"add-held"}
    :reason "Protocol-neutral custody-held-adjustment effect emits the add-held held action"
    :status :protocol-neutral}
   {:file "src/resolver_sim/economics/with_bounty/evaluation.clj"
    :literals #{"add-held"}
    :reason "with-bounty custody reservation effect emits the add-held held action"
    :status :protocol-neutral}
   {:file "src/resolver_sim/resubmission/store.clj"
    :literals #{:transaction/state-after-root state-after-root}
    :reason "Domain-neutral transaction-ordering state-after-root in the resubmission store projection"
    :status :protocol-neutral}
   {:file "src/resolver_sim/transaction/ordering.clj"
    :literals #{:transaction/state-after-root}
    :reason "Domain-neutral transaction-ordering state-after-root in the generic ordering primitive's required-fields contract"
    :status :protocol-neutral}
   {:file "src/resolver_sim/notebook_support/trust_boundary.clj"
    :literals #{:state-after-root}
    :reason "Domain-neutral state-after-root field in the trust-boundary projection"
    :status :protocol-neutral}]

  ;; ── legacy production gate (Phase 3B tombstone) ───────────────────────────
  ;; Phase 3B removed the legacy held-custody producers and the former core
  ;; legacy evidence namespace. The :forbidden/legacy-production-vars,
  ;; :permitted/legacy-read-vars, and :approved/legacy-production-locations
  ;; policy blocks were deleted with it: no legacy builder remains reachable
  ;; and no legacy producer registration is permitted. Reintroduction is
  ;; prevented by the tombstone gate test
  ;; (test/resolver_sim/architecture/legacy_production_gate_test.clj), not by
  ;; a config block.

  ;; ── architecture vocabulary ────────────────────────────────────────────────
 ;; The exact held-custody operation vocabulary (keywords) and the artifact
 ;; vocabulary prefixes. The vocabulary test derives its matchers from these
 ;; policies rather than hardcoding them.
 :architecture/operation-vocabulary
 #{:add-held :sub-held :finalize-released :refund-held}

  :architecture/artifact-vocabulary-prefixes
  #{"force-auth-add-held" "force-auth-held-custody"}

  :architecture/status-vocabulary
  #{:state-after :state-after-root :stablecoin :add-held :add-held-kind :cancellation}

  :rules [{:id :framework-does-not-depend-on-protocol-implementations
          :description "Every src production namespace is scanned. Direct require/use/import and literal namespace-resolution references to extension prefixes fail unless an exact reviewed bridge is configured."}
         {:id :extension-depends-on-framework
          :description "Protocol and evidence extensions may depend on framework interfaces and registries; framework code must not introduce named extension dependencies."}
         {:id :prf-jar-excludes-extension-sources
          :description "The PRF distribution is built from src and resources only; Sew source, corpus, and extension sources are supplied by explicit aliases."}]}
