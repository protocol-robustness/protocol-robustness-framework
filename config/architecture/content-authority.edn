{:schema-version 1

 :description
 "Non-framework authority/content classification for governed paths.

  Umbrella category: non-framework authority/content — NOT literally
  'user-defined'. Three orthogonal axes classify each governed file:

    :authority       — who has authority over the content
                       :prf | :protocol | :benchmark | :user
    :content-kind    — what kind of thing it is
                       :core-contract | :integration | :example
                       | :benchmark | :research | :demo | :test-support
    :support-status  — how it is supported
                       :normative | :supported | :illustrative | :experimental

  This is a SIDECAR manifest. It deliberately does not write an ownership
  field into any canonical artifact (content-addressed EDN/JSON, fixtures,
  goldens, traces, registries), because doing so would alter canonical bytes,
  roots, or the thing being tested. Classification of those files lives here.

  :governed-roots is the explicit scope. Every file inside a governed root
  must resolve to exactly one classification. Files outside governed roots
  are deliberately not governed yet (expansion: P0a semantic/high-risk →
  P0b suites/resources/fixtures → P0c docs/generated).

  Enforcement rules (see scripts/ownership_audit.clj):
    - every file inside :governed-roots resolves exactly once;
    - files outside governed roots are deliberately not governed yet;
    - a governed root with no classification rule is an error;
    - a rule matching only outside governed roots is an error;
    - overlapping defaults that disagree are an error;
    - a default glob that matches nothing (dead rule) is an error;
    - :mixed? true requires :reason and :split-intent.

  :known-missing-extension-points records surfaces where a protocol cannot
  supply a value without editing core. It is reported (advisory) in P0 and
  becomes a debt allowlist gate in P1: known debt may remain, new debt may
  not appear, resolved debt may not return."

 :governed-roots
 ["src/resolver_sim"
  "protocols_src"
  "scenarios/edn"
  "data/params"
  "data/yield"
  "benchmarks/packs"
  "notebooks"
  "examples"
  "site"]

 :allowed-authorities #{:prf :protocol :benchmark :user}
 :allowed-content-kinds #{:core-contract :integration :example
                          :benchmark :research :demo :test-support}
 :allowed-support-statuses #{:normative :supported :illustrative :experimental}
 :allowed-source-kinds #{:framework-example :external}

 :defaults
 [{:path "src/resolver_sim/**"
   :authority :prf :content-kind :core-contract :support-status :normative
   :reason "generic protocol-robustness framework machinery"}

  {:path "protocols_src/**"
   :authority :protocol :content-kind :integration :support-status :supported
   :reason "protocol-specific adapter/integration code"}

  ;; scenarios/edn is currently a flat, single-author (sew-v1) directory.
  ;; It therefore gets ONE weak default so it is not left unclassified, but
  ;; the flat layout (no sew/core/examples subtrees) is recorded as evidence
  ;; for a P2 subdivision rather than disguised by one broad classification.
  {:path "scenarios/edn/**"
   :authority :protocol :content-kind :benchmark :support-status :supported
   :reason "currently all sew-v1 scenarios; subtree subdivision (protocol/core/examples) is a P2 reorganization item"}

  {:path "data/params/**"
   :authority :user :content-kind :research :support-status :experimental
   :reason "research/experiment parameterisation (baseline, phase-*, stress)"}


  {:path "data/yield/**"
   :authority :protocol :content-kind :integration :support-status :supported
   :reason "yield-provider protocol content (invariant catalog); specific file carries an intrinsic-mixed override"}

  {:path "benchmarks/packs/sew/**"
   :authority :protocol :content-kind :benchmark :support-status :supported
   :reason "Sew protocol benchmark pack"}

  {:path "benchmarks/packs/prf-core/**"
   :authority :prf :content-kind :benchmark :support-status :normative
   :reason "PRF's own benchmark-infrastructure pack"}

  {:path "notebooks/**"
   :authority :prf :content-kind :demo :support-status :illustrative
   :reason "PRF-authored demonstrations of PRF; user/research-owned notebooks get overrides"}

  {:path "examples/**"
   :authority :prf :content-kind :example :support-status :illustrative
   :reason "PRF-authored illustrative examples; non-normative, user-replaceable"}

  {:path "site/**"
   :authority :prf :content-kind :demo :support-status :illustrative
   :reason "PRF product/demo site content"}]
 :overrides
 [{:path "examples/use-cases/**"
   :authority :user :content-kind :example :support-status :illustrative
   :source-kind :framework-example
   :reason "shipped use-case bundle exercising the same explicit external registry contract as user content"}

  {:path "src/resolver_sim/notebook_support/speds/config.clj"
   :mixed? true :split-intent :planned
   :reason "generic profile machinery is PRF-owned; Sew-specific sew-profile is protocol authority"}

  {:path "src/resolver_sim/definitions/registry.clj"
   :mixed? true :split-intent :planned
   :reason "registry mechanism is PRF-owned; Sew transitions/invariants/claims are protocol authority"}

  {:path "src/resolver_sim/definitions/solidity_shadow_registry.clj"
   :authority :protocol :content-kind :integration :support-status :supported
   :reason "sim-to-Solidity (BaseEscrow.sol etc.) correspondence is protocol-integration provenance"}

  {:path "src/resolver_sim/protocols/dummy.clj"
   :authority :prf :content-kind :test-support :support-status :supported
   :reason "deliberately synthetic reference adapter proving the extension interface"}

  {:path "src/resolver_sim/hash/canonical.clj"
   :mixed? true :split-intent :planned
   :reason "domain-tag/hash-intent mechanism and PRF-intrinsic registrations are PRF-owned; protocol-specific registrations (pro-rata, slash, bounty, pool, award, with-bounty, fail-action, lab) are protocol authority"}

  {:path "src/resolver_sim/definitions/passive_registries.clj"
   :mixed? true :split-intent :planned
   :reason "intent/projection/claim/execution registry machinery and PRF definitions are PRF-owned; Sew-scoped and pro-rata/yield registrations are protocol authority"}

  {:path "data/yield/invariant-catalog.edn"
   :mixed? true :split-intent :intrinsic
   :reason "invariant identity may be PRF verification; selection for a protocol config is protocol authority"}]

 :known-missing-extension-points
 [{:path "src/resolver_sim/hash/canonical.clj"
   :surface :rootzones
   :reason "domain-tags/hash-intents are hardcoded defs; a protocol cannot add a zone without editing core"}
  {:path "src/resolver_sim/definitions/passive_registries.clj"
   :surface :rootzones
   :reason "intent/projection/claim/execution registries are hardcoded defs; protocol registrations cannot be supplied externally"}]}
